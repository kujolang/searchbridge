{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kujolang.ai/searchbridge/capabilities.v1.json",
  "type": "object",
  "required": ["schema", "generated_at", "capabilities"],
  "properties": {
    "schema": {"const": "searchbridge.capabilities/v1"},
    "generated_at": {"type": "string", "minLength": 20},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability", "available", "degraded", "providers"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "available": {"type": "boolean"},
          "degraded": {"type": "boolean"},
          "providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["provider", "live_available", "fixture_available", "write", "missing_environment", "credential_ready", "support_tier", "support_reason"],
              "properties": {
                "provider": {"type": "string", "minLength": 1},
                "live_available": {"type": "boolean"},
                "fixture_available": {"const": true},
                "write": {"type": "boolean"},
                "missing_environment": {"type": "array", "items": {"type": "string"}},
                "credential_ready": {"type": "boolean"},
                "support_tier": {"enum": ["stable-live", "fixture-only", "external-reference", "disabled"]},
                "support_reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
