{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kujolang.ai/searchbridge/result.v1.json",
  "type": "object",
  "required": ["schema", "capability", "provider", "mode", "retrieved_at", "rows"],
  "properties": {
    "schema": {"const": "searchbridge.result/v1"},
    "capability": {"enum": ["search.performance", "analytics", "url.inspection", "page.performance", "field.performance", "backlinks", "keyword.data"]},
    "provider": {"type": "string", "minLength": 1},
    "mode": {"enum": ["fixture", "live"]},
    "retrieved_at": {"type": "string", "minLength": 20},
    "rows": {"type": "array", "maxItems": 1000}
  },
  "additionalProperties": true
}
