{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kujolang.ai/searchbridge/providers.v1.json",
  "type": "object",
  "required": ["schema", "providers"],
  "properties": {
    "schema": {"const": "searchbridge.providers/v1"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "capabilities", "env", "env_any", "optional_env", "write_capabilities"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "env": {"type": "array", "items": {"type": "string"}},
          "env_any": {"type": "array", "items": {"type": "string"}},
          "optional_env": {"type": "array", "items": {"type": "string"}},
          "write_capabilities": {"type": "array", "items": {"type": "string"}},
          "cost_class": {"type": "string"},
          "request_contract": {"type": "object"},
          "response_contract": {"type": "object"},
          "cost_warning": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
