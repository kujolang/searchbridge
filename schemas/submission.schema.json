{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kujolang.ai/searchbridge/submission.v1.json",
  "type": "object",
  "required": ["schema", "provider", "mode", "submitted_at", "authorization", "status", "received", "indexed", "urls", "claim"],
  "properties": {
    "schema": {"const": "searchbridge.submission/v1"},
    "provider": {"enum": ["indexnow", "bing-webmaster"]},
    "mode": {"enum": ["fixture", "live"]},
    "submitted_at": {"type": "string", "minLength": 20},
    "authorization": {
      "type": "object",
      "required": ["capability", "act", "confirmed"],
      "properties": {
        "capability": {"const": "index.submission"},
        "act": {"const": true},
        "confirmed": {"const": true}
      },
      "additionalProperties": false
    },
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "received": {"type": "boolean"},
    "indexed": {"const": false},
    "urls": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "string", "minLength": 8, "maxLength": 8192}},
    "claim": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
