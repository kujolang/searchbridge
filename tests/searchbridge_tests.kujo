mut passed := 0
mut failed := 0

func check(condition, label) {
	if condition { passed = passed + 1; print("ok - " + label); return }
	failed = failed + 1; eprint("not ok - " + label)
}

func options_for(command, tokens) {
	prepared := prepare_options(command, tokens)
	check(prepared["ok"], command + " options parse")
	return prepared["value"]
}

func runtime_schema(path) {
	raw := parse_json(read_file(path)); mut schema := {}
	for key in keys(raw) { if key != "$schema" && key != "$id" { schema[key] := raw[key] } }
	return schema
}

# Capability-level degradation is explicit and fixture work remains ready.
doctor_options := options_for("doctor", ["--deterministic"])
doctor := dispatch("doctor", doctor_options)
check(doctor["ok"] && doctor["value"]["ok"], "doctor succeeds without credentials")
check(doctor["value"]["runtime"] == "kujo-native", "doctor reports native Kujo runtime")
check(json_schema_validate(doctor["value"], runtime_schema("schemas/doctor.schema.json"))["valid"], "doctor satisfies its public schema")
caps := dispatch("capabilities", doctor_options)["value"]
check(json_schema_validate(caps, runtime_schema("schemas/capabilities.schema.json"))["valid"], "capabilities satisfy their public schema")
provider_catalog := dispatch("providers", doctor_options)["value"]
check(json_schema_validate(provider_catalog, runtime_schema("schemas/providers.schema.json"))["valid"], "providers satisfy their public schema")
mut degraded := false
for capability in caps["capabilities"] {
	if capability["degraded"] { degraded = true }
	mut write_seen := false
	for provider in capability["providers"] { if provider["write"] { write_seen = true } }
	check(write_seen == (capability["capability"] == "index.submission"), "write capability remains isolated: " + capability["capability"])
}
check(degraded, "missing credentials degrade individual capabilities")
check(doctor["value"]["health"] == "degraded", "doctor exposes explicit degraded health")
conformance := adapter_conformance_report()
check(conformance["ok"] && conformance["adapter_count"] == 12 && len(conformance["reports"]) == 12, "built-in and external adapters pass one conformance report")
registry := adapters()
check(validate_registry(registry)["ok"] && len(keys(registry)) == 11, "canonical adapter v2 registry validates")
check(providers_for("serp.results", false) == ["dataforseo", "serpapi"], "registry discovers providers in deterministic order")
explicit_route := resolve("analytics", "google-analytics-4", [], [])
check(explicit_route["ok"] && explicit_route["value"]["mode"] == "explicit", "registry resolves explicit providers")
auto_route := resolve("serp.results", "auto", ["serpapi", "dataforseo"], ["serpapi", "dataforseo"])
check(auto_route["ok"] && auto_route["value"]["selected"] == ["serpapi"], "registry auto routing follows configured preferences")
all_route := resolve("serp.results", "all", ["serpapi", "dataforseo"], ["serpapi", "dataforseo"])
check(all_route["ok"] && all_route["value"]["selected"] == ["serpapi", "dataforseo"], "registry all routing preserves configured order")
check(utf8_size(to_json(agent_catalog())) <= 4096, "agent catalog stays within the 4 KiB budget")
agent_catalog_result := dispatch("agent-catalog", options_for("agent-catalog", ["--deterministic"]))
check(agent_catalog_result["ok"] && json_schema_validate(agent_catalog_result["value"], runtime_schema("schemas/agent-catalog.schema.json"))["valid"], "agent-facing catalog is generated from registry metadata")
agent_tools := parse_json(read_file("integrations/searchbridge-tools.json"))
check(utf8_size(to_json(agent_tools)) <= 4096 && len(agent_tools["tools"]) == 4 && agent_tools["tools"][3]["input_schema"]["properties"]["act"]["const"], "agent tool surface is concise and preserves submission confirmation")
for name in ["rank-tracking", "serp-results", "domain-visibility", "traffic-estimate", "edge-analytics", "crawl-data"] {
	row := parse_json(read_file("examples/rows/" + name + ".json")); schema := runtime_schema("schemas/rows/" + name + ".schema.json")
	check(json_schema_validate(row, schema)["valid"], name + " canonical example satisfies its row schema")
	if has_key(row, "metrics") { for observation in row["metrics"] { check(json_schema_validate(observation, runtime_schema("schemas/metric-observation.schema.json"))["valid"], name + " metric observation satisfies shared schema") } }
}
visibility_metric := parse_json(read_file("examples/rows/domain-visibility.json"))["metrics"][0]
traffic_metric := parse_json(read_file("examples/rows/traffic-estimate.json"))["metrics"][0]
check(visibility_metric["comparison_key"] == null && visibility_metric["metric_id"] != traffic_metric["metric_id"], "incompatible provider metrics cannot claim arithmetic equivalence")

# Semantic fetch preserves provider envelopes, routing evidence, global budgets, and paid-call policy.
serp_fetch := dispatch("fetch", options_for("fetch", ["--capability", "serp.results", "--provider", "serpapi", "--fixture", "--offline", "--deterministic"]))
check(serp_fetch["ok"] && serp_fetch["value"]["provider"] == "serpapi" && serp_fetch["value"]["contract"]["adapter"] == "searchbridge-adapter/v2", "semantic fetch executes an explicit built-in adapter")
auto_fetch := dispatch("fetch", options_for("fetch", ["--capability", "serp.results", "--provider", "auto", "--route-preferences", "serpapi,dataforseo", "--enabled-providers", "serpapi,dataforseo", "--fixture", "--offline", "--deterministic"]))
check(auto_fetch["ok"] && auto_fetch["value"]["provider"] == "serpapi" && auto_fetch["value"]["routing"]["candidates"][0]["reason"] == "configured and capable", "auto fetch explains deterministic configured selection")
all_fetch := dispatch("fetch", options_for("fetch", ["--capability", "serp.results", "--provider", "all", "--route-preferences", "serpapi,dataforseo", "--enabled-providers", "serpapi,dataforseo", "--fixture", "--offline", "--deterministic"]))
check(all_fetch["ok"] && all_fetch["value"]["schema"] == "searchbridge.multi-result/v1" && all_fetch["value"]["succeeded"] == 2 && json_schema_validate(all_fetch["value"], runtime_schema("schemas/multi-result.schema.json"))["valid"], "all fetch returns intact stable multi-provider envelopes")
check(all_fetch["value"]["budget"]["calls_used"] == 0 && all_fetch["value"]["budget"]["pages_used"] == 2 && all_fetch["value"]["budget"]["result_bytes_used"] > 0, "all fetch reports aggregate fixture budget use")
bounded_all := dispatch("fetch", options_for("fetch", ["--capability", "serp.results", "--provider", "all", "--route-preferences", "serpapi,dataforseo", "--enabled-providers", "serpapi,dataforseo", "--max-total-rows", "1", "--fixture", "--offline", "--deterministic"]))
check(bounded_all["ok"] && bounded_all["value"]["succeeded"] == 1 && bounded_all["value"]["failed"] == 1, "all fetch retains explicit partial failures at the global row budget")
mut fingerprint_options := options_for("fetch", ["--capability", "serp.results", "--provider", "serpapi", "--fixture", "--offline", "--deterministic"]); base_fingerprint := query_fingerprint(fingerprint_options, "serp.results"); fingerprint_options["start_date"] = "2026-08-01"; dated_fingerprint := query_fingerprint(fingerprint_options, "serp.results"); fingerprint_options["out"] = "/tmp/ignored-output"; output_fingerprint := query_fingerprint(fingerprint_options, "serp.results")
check(base_fingerprint != dated_fingerprint && dated_fingerprint == output_fingerprint, "query identity covers semantic inputs and excludes execution-only output paths")
env_set("SEARCHBRIDGE_SERPAPI_KEY", "fixture-key"); env_set("SEARCHBRIDGE_DATAFORSEO_LOGIN", "fixture-login"); env_set("SEARCHBRIDGE_DATAFORSEO_PASSWORD", "fixture-password")
budgeted_all_options := options_for("fetch", ["--capability", "serp.results", "--provider", "all", "--route-preferences", "serpapi,dataforseo", "--enabled-providers", "serpapi,dataforseo", "--allow-paid", "--max-calls", "2", "--max-provider-units", "2", "--deterministic"]); budgeted_all_options["transport"] = dataforseo_task_contract_transport; budgeted_all := dispatch("fetch", budgeted_all_options)
check(budgeted_all["ok"] && budgeted_all["value"]["succeeded"] == 2 && budgeted_all["value"]["budget"]["calls_used"] == 2 && budgeted_all["value"]["budget"]["provider_units_used"] == 2.0, "all fetch enforces and accounts one aggregate live call/unit budget")
exhausted_all_options := options_for("fetch", ["--capability", "serp.results", "--provider", "all", "--route-preferences", "serpapi,dataforseo", "--enabled-providers", "serpapi,dataforseo", "--allow-paid", "--max-calls", "1", "--max-provider-units", "1", "--deterministic"]); exhausted_all_options["transport"] = dataforseo_task_contract_transport; exhausted_all := dispatch("fetch", exhausted_all_options)
check(exhausted_all["ok"] && exhausted_all["value"]["succeeded"] == 1 && exhausted_all["value"]["failed"] == 1 && exhausted_all["value"]["budget"]["calls_used"] == 1, "all fetch never exceeds an aggregate call budget while retaining partial results")
check(result_exit_code("fetch", {"schema": "searchbridge.multi-result/v1", "succeeded": 0}) == 1 && result_exit_code("fetch", exhausted_all["value"]) == 0, "all-provider failure is machine-detectable without discarding partial output")
env_set("SEARCHBRIDGE_SERPAPI_KEY", ""); env_set("SEARCHBRIDGE_DATAFORSEO_LOGIN", ""); env_set("SEARCHBRIDGE_DATAFORSEO_PASSWORD", "")
paid_denied := dispatch("fetch", options_for("fetch", ["--capability", "serp.results", "--provider", "serpapi"]))
check(!paid_denied["ok"] && contains(paid_denied["error"], "allow-paid") == 1, "paid live fetch fails before credential or transport without explicit budgets")
check(!prepare_options("fetch", ["--capability", "serp.results", "--provider", "auto"])["ok"], "auto routing cannot silently use unconfigured fallback order")
env_set("SEARCHBRIDGE_DATAFORSEO_LOGIN", "fixture-login"); env_set("SEARCHBRIDGE_DATAFORSEO_PASSWORD", "fixture-password")
task_fetch_options := options_for("fetch", ["--capability", "rank.tracking", "--provider", "dataforseo", "--allow-paid", "--max-calls", "2", "--max-provider-units", "1", "--max-polls", "1", "--deterministic"]); task_fetch_options["transport"] = dataforseo_task_contract_transport
task_fetch := dispatch("fetch", task_fetch_options)
check(task_fetch["ok"] && task_fetch["value"]["rows"][0]["rank"] == 4 && task_fetch["value"]["telemetry"]["task_polls"] == 1, "DataForSEO standard task flow is bounded from post through completion")
env_set("SEARCHBRIDGE_DATAFORSEO_LOGIN", ""); env_set("SEARCHBRIDGE_DATAFORSEO_PASSWORD", "")

# Protocol primitives are finite and reject amplification and parser abuse.
check(!cursor_sequence(["a", "a"], 3)["ok"] && cursor_sequence(["a", "b"], 2)["ok"], "cursor pagination rejects repetition and obeys page budgets")
task_done := async_task_sequence([{"id": "task-1", "status": "pending", "elapsed_ms": 10}, {"id": "task-1", "status": "completed", "elapsed_ms": 10, "result": {"rows": []}}], 2, 100)
check(task_done["ok"] && task_done["value"]["polls"] == 2, "async task state machine completes within poll and elapsed budgets")
check(!async_task_sequence([{"id": "bad\nvalue", "status": "pending"}], 2, 100)["ok"], "async task IDs reject control characters")
csv_ok := bounded_csv_parse("name;value\nx;=CMD()\n", 2, 4, 32)
check(csv_ok["ok"] && !bounded_csv_parse("name;name\nx;y\n", 2, 4, 32)["ok"], "bounded CSV parser treats formulas as data and rejects duplicate headers")
check(!graphql_result({"data": null, "errors": [{"message": "token=secret"}]})["ok"] && contains(graphql_result({"data": null, "errors": [{"message": "token=secret"}]})["error"], "secret") == 0, "GraphQL failures do not echo provider errors")
check(!cost_preflight("metered", false, false, 1, 1)["ok"] && cost_preflight("metered", true, false, 0, 0)["ok"], "cost policy blocks paid live calls and exempts zero-call fixtures")
stream_probe_path := "/tmp/searchbridge-stream-probe-" + to_string(current_timestamp()) + ".jsonl"; stream_probe := stream_synthetic_jsonl(stream_probe_path, 1000, 1048576)
check(stream_probe["ok"] && stream_probe["value"]["retained_rows"] <= 1000 && stream_probe["value"]["atomic"] && len(read_lines(stream_probe_path)) == 1000, "large-result JSONL streaming retains one page and publishes atomically"); delete_file(stream_probe_path)
fixture_contracts := parse_json(read_file("fixtures/provider-cases.json")); mut fixture_contracts_complete := true
for operation_id in keys(fixture_contracts["operations"]) { for case_name in fixture_contracts["required_cases"] { if has_key(fixture_contracts["operations"][operation_id], case_name) == 0 { fixture_contracts_complete = false } } }
check(fixture_contracts_complete, "every batch-1 operation declares the provider-neutral fixture minimum")
check(validate_exact_endpoint("https://serpapi.com/search.json?q=x", "https://serpapi.com/search.json", true)["ok"] && !validate_exact_endpoint("https://serpapi.com.evil/search.json", "https://serpapi.com/search.json", true)["ok"] && !validate_exact_endpoint("https://127.0.0.1/data", "https://127.0.0.1/data", false)["ok"], "final endpoint validation is exact and denies private destinations")
check(!validate_exact_endpoint("https://[::1]/data", "https://[::1]/data", false)["ok"] && !validate_exact_endpoint("https://tést.example/data", "https://tést.example/data", false)["ok"], "endpoint validation rejects loopback IPv6 and non-ASCII IDN ambiguity")
semrush_retention := dispatch("fetch", options_for("fetch", ["--capability", "domain.visibility", "--provider", "semrush", "--fixture", "--cache-dir", "/tmp/searchbridge-unused", "--cache-max-age", "2592001"]))
check(!semrush_retention["ok"] && contains(semrush_retention["error"], "retention") == 1, "Semrush replay retention is capped at one month")
check(!cost_preflight("metered", false, true, 1, 0.5)["ok"], "provider-unit estimates cannot exceed the declared paid budget")
mut deep_value := {}; mut depth_index := 0; while depth_index < 22 { deep_value = {"nested": deep_value}; depth_index = depth_index + 1 }
check(!value_within_bounds(deep_value, 0), "deep provider JSON is rejected by structural bounds")
check(!bounded_csv_parse("name;value\nx;" + repeat("x", 1025) + "\n", 2, 4, 1024)["ok"], "oversized CSV cells are rejected")
security_corpus := parse_json(read_file("fixtures/security/provider-expansion-adversarial.json"))
check(len(security_corpus["cases"]) == 27, "provider expansion adversarial corpus remains complete")

# Every declared read adapter normalizes through a deterministic fixture.
fixture_cases := [
	["search-performance", []],
	["search-performance", ["--provider", "bing-webmaster"]],
	["analytics", []], ["inspect-url", []], ["pagespeed", []], ["crux", []],
	["backlinks", []], ["backlinks", ["--provider", "bing-webmaster"]], ["keyword-data", []]
]
mut fixture_paths := []
for name in list_dir("fixtures/providers") { fixture_paths = push(fixture_paths, "fixtures/providers/" + name) }
mut before_hashes := {}
for path in fixture_paths { if ends_with(path, ".json") { before_hashes[path] := sha256_file(path) } }
for item in fixture_cases {
	command := item[0]; tokens := concat(item[1], ["--fixture", "--offline", "--deterministic"])
	result := dispatch(command, options_for(command, tokens))
	check(result["ok"], command + " fixture succeeds")
	if result["ok"] {
		check(json_schema_validate(result["value"], runtime_schema("schemas/result.schema.json"))["valid"], command + " satisfies result schema")
		check(result["value"]["schema"] == "searchbridge.result/v1", command + " uses result schema")
		check(result["value"]["mode"] == "fixture", command + " identifies fixture mode")
		check(len(result["value"]["rows"]) > 0, command + " emits normalized rows")
		check(result["value"]["retrieved_at"] == "1970-01-01T00:00:00Z", command + " is deterministic")
	}
}
for path in keys(before_hashes) { check(before_hashes[path] == sha256_file(path), "fixture remains immutable: " + path) }

# Output files and budgets are bounded.
output_path := "/tmp/searchbridge-output-test-" + to_string(current_timestamp()) + ".json"
analytics_options := options_for("analytics", ["--fixture", "--deterministic", "--out", output_path])
analytics := dispatch("analytics", analytics_options)
written := render_output(analytics["value"], analytics_options)
check(written["ok"] && file_exists(output_path), "output artifact is written")
check(parse_json(read_file(output_path))["capability"] == "analytics", "output artifact contains normalized result")
delete_file(output_path)
small_options := options_for("analytics", ["--fixture", "--max-output-bytes", "256"])
check(!render_output(analytics["value"], small_options)["ok"], "byte output budget is enforced")
check(!prepare_options("backlinks", ["--fixture", "--limit", "1001"])["ok"], "row limit is bounded")
bounded_gsc := normalize_gsc({"rows": [{"keys": ["a"]}, {"keys": ["b"]}]}, ["query"], "sc-domain:example.com", "fixture", 1, true)
check(len(bounded_gsc["rows"]) == 1, "provider rows are bounded after normalization")
check(analytics["value"]["pagination"]["max_total_rows"] == 1000 && analytics["value"]["telemetry"]["rows"] == len(analytics["value"]["rows"]), "pagination and row telemetry are structured")
jsonl_options := options_for("analytics", ["--fixture", "--format", "jsonl", "--out", output_path])
check(render_output(analytics["value"], jsonl_options)["ok"] && len(split(trim(read_file(output_path)), "\n")) == len(analytics["value"]["rows"]), "JSONL rows stream within output budgets")
delete_file(output_path)

# Credential-independent replay and third-party adapter extension points.
hash_a := credential_independent_request_hash("GET", "https://example.com/?access_token=one&q=x", {"api_key": "one"})
hash_b := credential_independent_request_hash("GET", "https://example.com/?access_token=two&q=x", {"api_key": "two"})
check(hash_a == hash_b, "cache hashes exclude credentials")
cache_dir := "/tmp/searchbridge-cache-test-" + to_string(current_timestamp()); write_cached_response(cache_dir, hash_a, 200, {"rows": []}, current_timestamp(), "2026-08-12T00:00:00Z")
check(read_cached_response(cache_dir, hash_b, 60, current_timestamp())["ok"], "approved cache evidence replays by credential-independent hash")
delete_file(cache_dir + "/" + hash_a + ".json"); os_rmdir(cache_dir)
protected_dir := "/tmp/searchbridge-protected-cache-" + to_string(current_timestamp()); env_set("SEARCHBRIDGE_TEST_CACHE_KEY", "local-test-key")
check(write_protected_cached_response(protected_dir, hash_a, 200, {"rows": [{"id": 1}]}, current_timestamp(), "2026-08-12T00:00:00Z", {"encryption_key_env": "SEARCHBRIDGE_TEST_CACHE_KEY"})["ok"], "encrypted replay record is written")
protected_record := parse_json(read_file(protected_dir + "/" + hash_a + ".json")); protected_text := read_file(protected_dir + "/" + hash_a + ".json"); check(protected_record["schema"] == "searchbridge.cache/v2" && contains(protected_text, "\"body\":") == 0, "encrypted replay record hides provider evidence at rest")
protected_read := read_protected_cached_response(protected_dir, hash_a, 60, current_timestamp(), {"encryption_key_env": "SEARCHBRIDGE_TEST_CACHE_KEY", "require_encryption": true})
check(protected_read["ok"] && protected_read["value"]["body"]["rows"][0]["id"] == 1, "encrypted replay verifies integrity and decrypts")
protected_record["integrity"] = "tampered"; write_file(protected_dir + "/" + hash_a + ".json", to_json(protected_record), true)
check(!read_protected_cached_response(protected_dir, hash_a, 60, current_timestamp(), {"encryption_key_env": "SEARCHBRIDGE_TEST_CACHE_KEY", "require_encryption": true})["ok"], "tampered replay records fail closed")
delete_file(protected_dir + "/" + hash_a + ".json"); os_rmdir(protected_dir); env_set("SEARCHBRIDGE_TEST_CACHE_KEY", "")
denied_replay := request_json("https://example.com/evidence", "GET", null, {}, {"offline": false, "replay": false, "cache_dir": "/tmp/unused-searchbridge-cache", "current_capability": "analytics", "replay_capabilities": ["page.performance"]}, null)
check(!denied_replay["ok"] && contains(denied_replay["error"], "allowlisted") == 1, "replay capability allowlist fails closed before network access")
third_party := {"name": "example-third-party", "capabilities": ["example.read"], "write_capabilities": [], "cost_class": "free", "request_contract": {}, "response_contract": {}, "discovery": {"kind": "static"}, "request": {"method": "GET", "endpoint": "https://api.example.com/evidence"}, "normalization": {"rows": "rows[]"}, "write_boundary": {"allowed": false}}
registry := register_adapter({}, third_party)
check(validate_adapter(third_party)["ok"] && registry["ok"] && execute_adapter(registry["value"], "example-third-party", "example.read", {})["ok"], "third-party adapters register and execute without CLI dispatch edits")
adapter_path := "/tmp/searchbridge-adapter-" + to_string(current_timestamp()) + ".json"; signature_path := adapter_path + ".sig"
signed_adapter := {"name": "signed-example", "capabilities": ["example.read"], "write_capabilities": [], "cost_class": "free", "request_contract": {}, "response_contract": {}, "discovery": {"kind": "signed-manifest"}, "request": {"method": "GET", "endpoint": "https://api.example.com/evidence", "credential_env": "EXAMPLE_ADAPTER_TOKEN", "credential_header": "Authorization", "credential_prefix": "Bearer "}, "normalization": {"rows_field": "rows"}, "write_boundary": {"allowed": false}, "fixture_response": {"rows": [{"id": "signed"}]}}
manifest_text := to_json(signed_adapter); adapter_keypair := rsa_generate_keypair(2048); env_set("SEARCHBRIDGE_ADAPTER_SIGNING_KEY", adapter_keypair["public"]); write_file(adapter_path, manifest_text, true); write_file(signature_path, rsa_sign(manifest_text, adapter_keypair["private"]), true)
loaded_adapter := load_signed_adapter(adapter_path, signature_path, "SEARCHBRIDGE_ADAPTER_SIGNING_KEY", ["example.read"], ["https://api.example.com/evidence"], ["EXAMPLE_ADAPTER_TOKEN"])
check(loaded_adapter["ok"], "signed external adapter passes manifest and capability allowlists")
adapter_options := options_for("adapter-run", ["--fixture", "--deterministic", "--capability", "example.read", "--adapter-manifest", adapter_path, "--adapter-signature", signature_path, "--adapter-key-env", "SEARCHBRIDGE_ADAPTER_SIGNING_KEY", "--adapter-allow-capabilities", "example.read", "--adapter-allow-endpoints", "https://api.example.com/evidence", "--adapter-allow-credentials", "EXAMPLE_ADAPTER_TOKEN"])
adapter_result := run_signed_adapter(adapter_options); check(adapter_result["ok"] && adapter_result["value"]["rows"][0]["id"] == "signed", "signed adapter executes without source edits")
check(!load_signed_adapter(adapter_path, signature_path, "SEARCHBRIDGE_ADAPTER_SIGNING_KEY", ["other.read"], ["https://api.example.com/evidence"], ["EXAMPLE_ADAPTER_TOKEN"])["ok"], "signed adapter capability escalation is rejected")
delete_file(adapter_path); delete_file(signature_path); env_set("SEARCHBRIDGE_ADAPTER_SIGNING_KEY", "")

# Adapter v2 verifies canonical signed package digests before credentials and stays read-only.
env_set("SEARCHBRIDGE_PLAUSIBLE_TRUST_KEY", read_file("adapters/plausible/trust-key.pem"))
plausible_options := options_for("adapter-run", ["--fixture", "--offline", "--deterministic", "--capability", "analytics", "--adapter-manifest", "adapters/plausible/adapter.json", "--adapter-signature", "adapters/plausible/adapter.sig", "--adapter-key-env", "SEARCHBRIDGE_PLAUSIBLE_TRUST_KEY", "--adapter-allow-capabilities", "analytics", "--adapter-allow-endpoints", "https://plausible.io/api/v2/query", "--adapter-allow-credentials", "SEARCHBRIDGE_PLAUSIBLE_TOKEN"])
plausible_result := run_signed_adapter(plausible_options)
check(plausible_result["ok"] && plausible_result["value"]["provider"] == "plausible" && len(plausible_result["value"]["rows"]) == 2, "signed Plausible adapter v2 executes its synthetic fixture")
plausible_manifest := parse_json(read_file("adapters/plausible/adapter.json")); mut malicious_operation := plausible_manifest["operations"][0]; malicious_operation["class"] = "write"; plausible_manifest["operations"] = [malicious_operation]
check(!validate_adapter_v2(plausible_manifest)["ok"], "external adapter v2 rejects write operations")
tamper_dir := "/tmp/searchbridge-adapter-v2-" + to_string(current_timestamp()); create_dir(tamper_dir); create_dir(tamper_dir + "/fixtures")
write_file(tamper_dir + "/adapter.json", read_file("adapters/plausible/adapter.json"), true); write_file(tamper_dir + "/adapter.sig", read_file("adapters/plausible/adapter.sig"), true); write_file(tamper_dir + "/fixtures/analytics.json", "{\"results\":[]}", true)
tampered_options := plausible_options; tampered_options["adapter_manifest"] = tamper_dir + "/adapter.json"; tampered_options["adapter_signature"] = tamper_dir + "/adapter.sig"
check(!run_signed_adapter(tampered_options)["ok"], "adapter v2 rejects a tampered package file before execution")
delete_file(tamper_dir + "/adapter.json"); delete_file(tamper_dir + "/adapter.sig"); delete_file(tamper_dir + "/fixtures/analytics.json"); os_rmdir(tamper_dir + "/fixtures"); os_rmdir(tamper_dir); env_set("SEARCHBRIDGE_PLAUSIBLE_TRUST_KEY", "")

# Submission is fail-closed and URL parsing strips fragments without leaking credentials.
base_submit := ["--fixture", "--url", "https://example.com/new"]
check(!dispatch("submit", options_for("submit", base_submit))["ok"], "submission rejects missing authorization")
check(!dispatch("submit", options_for("submit", concat(base_submit, ["--act", "--yes"])))["ok"], "submission rejects missing capability")
authorized := options_for("submit", concat(base_submit, ["--capability", "index.submission", "--act", "--yes", "--deterministic"]))
receipt := dispatch("submit", authorized)
check(receipt["ok"] && receipt["value"]["received"] && !receipt["value"]["indexed"], "submission receipt never claims indexing")
check(json_schema_validate(receipt["value"], runtime_schema("schemas/submission.schema.json"))["valid"], "submission satisfies its public schema")
check(!dispatch("submit", options_for("submit", ["--fixture", "--url", "https://example.com/a", "--url", "https://other.example/b", "--capability", "index.submission", "--act", "--yes"]))["ok"], "mixed-host submissions are rejected")
check(!dispatch("submit", options_for("submit", ["--fixture", "--url", "https://example.com/a", "--key-location", "https://other.example/key.txt", "--capability", "index.submission", "--act", "--yes"]))["ok"], "cross-host IndexNow key locations are rejected")
check(!dispatch("submit", options_for("submit", ["--fixture", "--url", "https://example.com/a", "--endpoint", "https://attacker.example/collect", "--capability", "index.submission", "--act", "--yes"]))["ok"], "custom submission endpoints are rejected in every mode")
check(!dispatch("submit", options_for("submit", ["--fixture", "--provider", "bing-webmaster", "--url", "https://example.com/a", "--property", "https://other.example/", "--capability", "index.submission", "--act", "--yes"]))["ok"], "cross-host Bing properties are rejected")
for bad_url in ["", "ftp://example.com", "https://u:p@example.com", "http://example.com:99999", "https://example.com/a\nb"] {
	check(!normalize_submission_url(bad_url)["ok"], "unsafe URL is rejected")
}
normalized := normalize_submission_url("https://EXAMPLE.com/path?q=1#secret")
check(normalized["ok"] && normalized["value"]["host"] == "example.com" && contains(normalized["value"]["url"], "secret") == 0, "submission URL is normalized and fragment-free")
check(utf8_size("Kujo é") == 7, "UTF-8 budgets count bytes exactly")
check(!dispatch("pagespeed", options_for("pagespeed", ["--fixture", "--url", "https://user:pass@example.com/"]))["ok"], "evidence URLs reject embedded credentials")

# Request retries are bounded and response/error bodies are not exposed.
probe := retry_contract_probe()
check(probe["retried"]["ok"], "JSON headers are set and 429 is retried once then succeeds")
check(should_retry_status(503) && !should_retry_status(400), "only transient status codes retry")
check(!probe["failed"]["ok"], "transport retries are bounded")
check(contains(probe["failed"]["error"], "super-secret") == 0, "transport errors are redacted")
check(contains(clean_error("Authorization=secret-value"), "secret-value") == 0, "authorization values are redacted")
check(contains(clean_error("Authorization: Basic c2VjcmV0OnBhc3N3b3Jk"), "c2VjcmV0") == 0 && contains(clean_error("{\"password\":\"secret-value\"}"), "secret-value") == 0, "Basic and JSON body credentials are redacted")
body_hash_a := credential_independent_request_hash("POST", "https://example.com/?password=one", {"password": "one", "query": "safe"}); body_hash_b := credential_independent_request_hash("POST", "https://example.com/?password=two", {"password": "two", "query": "safe"})
check(body_hash_a == body_hash_b, "query and body password credentials are absent from cache fingerprints")
call_budget_probe := call_budget_contract_probe()
check(!call_budget_probe["limited"]["ok"] && call_budget_probe["sufficient"]["ok"] && call_budget_probe["sufficient"]["value"]["telemetry"]["attempts"] == 2, "retry amplification is included in the call budget")
check(query_encode("café & 東京/💡") == "caf%C3%A9%20%26%20%E6%9D%B1%E4%BA%AC%2F%F0%9F%92%A1", "RFC 3986 encoder handles UTF-8 and reserved characters")

# Parser rejects ambiguous or invalid input.
check(!prepare_options("analytics", ["--wat"])["ok"], "unknown flags are rejected")
check(!prepare_options("analytics", ["--limit", "1", "--limit", "2"])["ok"], "duplicate scalar flags are rejected")
check(!prepare_options("analytics", ["--offline"])["ok"], "offline mode requires fixtures")
check(!prepare_options("analytics", ["--replay"])["ok"], "replay requires an explicit cache directory")
profile_options := prepare_options("analytics", ["--config", "config/searchbridge.example.toml", "--profile", "ci", "--fixture", "--max-pages", "7"])
check(profile_options["ok"] && profile_options["value"]["max_total_rows"] == 1000 && profile_options["value"]["max_pages"] == 7, "configuration precedence is defaults then profile then explicit CLI")
nested_config := prepare_options("fetch", ["--config", "config/searchbridge.example.toml", "--capability", "serp.results", "--provider", "auto", "--fixture"])
check(nested_config["ok"] && nested_config["value"]["route_preferences"] == "serpapi,dataforseo" && nested_config["value"]["enabled_providers"] == "cloudflare,dataforseo,serpapi", "nested routing and provider enablement configuration is typed and deterministic")
secret_config_path := "/tmp/searchbridge-secret-config-" + to_string(current_timestamp()) + ".toml"; write_file(secret_config_path, "[providers.serpapi]\nenabled = true\ncredential_token = \"must-not-load\"\n", true)
check(!prepare_options("fetch", ["--config", secret_config_path, "--capability", "serp.results", "--provider", "serpapi", "--fixture"])["ok"], "nested configuration rejects credential-shaped keys at every depth"); delete_file(secret_config_path)
check(!prepare_options("pagespeed", ["--strategy", "tablet"])["ok"], "invalid strategy is rejected")
check(!dispatch("keyword-data", options_for("keyword-data", ["--fixture", "--country", "USA"]))["ok"], "invalid country codes are rejected")
bad_dates := dispatch("search-performance", options_for("search-performance", ["--property", "sc-domain:example.com", "--start-date", "2026-13-01", "--end-date", "2026-13-02"]))
check(!bad_dates["ok"] && contains(bad_dates["error"], "dates") == 1, "invalid GSC date ranges fail before authentication")
batch := dispatch("batch", options_for("batch", ["--fixture", "--offline", "--deterministic", "--commands", "pagespeed,crux", "--max-concurrency", "2"]))
check(batch["ok"] && batch["value"]["succeeded"] == 2 && batch["value"]["bounded_concurrency"] == 2 && batch["value"]["execution"] == "bounded-worker-pool", "bounded worker pool preserves independent successes")
pool_probe := batch_worker_pool_probe(); check(pool_probe["ordered"] == [0, 1, 2] && pool_probe["overlapped"], "bounded worker pool overlaps work and preserves deterministic ordering")
cancel_path := "/tmp/searchbridge-cancel-" + to_string(current_timestamp()); write_file(cancel_path, "cancel", true); cancelled := dispatch("batch", options_for("batch", ["--fixture", "--offline", "--commands", "pagespeed,crux", "--cancel-file", cancel_path])); check(cancelled["ok"] && cancelled["value"]["failed"] == 2, "bounded worker pool honors cancellation without losing partial-success shape"); delete_file(cancel_path)

# Provider pages stream incrementally to atomic JSONL artifacts without retaining accumulated rows.
gsc_out := "/tmp/searchbridge-gsc-pages-" + to_string(current_timestamp()) + ".jsonl"; env_set("SEARCHBRIDGE_GSC_TOKEN", "fixture-token")
gsc_options := options_for("search-performance", ["--property", "sc-domain:example.com", "--start-date", "2026-08-01", "--end-date", "2026-08-02", "--dimensions", "date,query", "--page-size", "2", "--max-pages", "3", "--max-total-rows", "3", "--format", "jsonl", "--out", gsc_out, "--deterministic"]); gsc_options["transport"] = gsc_page_contract_transport
gsc_streamed := dispatch("search-performance", gsc_options); check(gsc_streamed["ok"] && len(gsc_streamed["value"]["rows"]) == 0 && len(read_lines(gsc_out)) == 3, "live GSC pages normalize and emit incrementally"); delete_file(gsc_out); env_set("SEARCHBRIDGE_GSC_TOKEN", "")
ga_out := "/tmp/searchbridge-ga-pages-" + to_string(current_timestamp()) + ".jsonl"; env_set("SEARCHBRIDGE_GA4_TOKEN", "fixture-token")
ga_options := options_for("analytics", ["--property", "123", "--dimensions", "date", "--metrics", "sessions", "--page-size", "2", "--max-pages", "3", "--max-total-rows", "3", "--format", "jsonl", "--out", ga_out, "--deterministic"]); ga_options["transport"] = ga_page_contract_transport
ga_streamed := dispatch("analytics", ga_options); check(ga_streamed["ok"] && len(ga_streamed["value"]["rows"]) == 0 && len(read_lines(ga_out)) == 3, "live GA4 pages normalize and emit incrementally"); delete_file(ga_out); env_set("SEARCHBRIDGE_GA4_TOKEN", "")

# Privacy-preserving OpenTelemetry and bounded local evidence queries.
privacy_payload := otel_payload("pagespeed", {"schema": "searchbridge.result/v1", "capability": "page.performance", "provider": "pagespeed-insights", "rows": [{"url": "https://secret.example/path?token=x"}], "telemetry": {"latency_ms": 3, "rows": 1}}, "searchbridge-test", true)
check(validate_otel_privacy(privacy_payload)["ok"] && contains(to_json(privacy_payload), "secret.example") == 0 && contains(to_json(privacy_payload), "token=x") == 0, "OpenTelemetry export preserves the no-URL/no-token/no-row boundary")
for sensitive in parse_json(read_file("fixtures/security/otel-redaction.json")) { corpus_payload := otel_payload("redaction-corpus", {"schema": "searchbridge.result/v1", "capability": "example.read", "provider": "external", "rows": [sensitive], "telemetry": {"rows": 1}}, "searchbridge-test", true); serialized := to_json(corpus_payload); check(validate_otel_privacy(corpus_payload)["ok"] && contains(serialized, "secret") == 0 && contains(serialized, "private.example") == 0 && contains(serialized, "person@example.com") == 0, "OpenTelemetry redaction corpus excludes sensitive input") }
otel_path := "/tmp/searchbridge-otel-" + to_string(current_timestamp()) + ".jsonl"; otel_options := options_for("pagespeed", ["--fixture", "--otel-endpoint", "file:" + otel_path, "--deterministic"]); check(export_otel("pagespeed", privacy_payload, otel_options, null)["ok"] && file_exists(otel_path), "OpenTelemetry export is explicit opt-in"); delete_file(otel_path)
evidence_left := "/tmp/searchbridge-evidence-left-" + to_string(current_timestamp()) + ".jsonl"; evidence_right := evidence_left + ".right"; write_file(evidence_left, "{\"provider\":\"gsc\",\"row\":{\"id\":1}}\n{\"provider\":\"ga4\",\"row\":{\"id\":2}}\n", true); write_file(evidence_right, "{\"id\":1,\"label\":\"match\"}\n", true)
query_result := dispatch("evidence-query", options_for("evidence-query", ["--evidence-path", evidence_left, "--filter-field", "provider", "--filter-equals", "gsc", "--join-path", evidence_right, "--left-field", "row.id", "--right-field", "id", "--max-total-rows", "10"]))
check(query_result["ok"] && len(query_result["value"]["rows"]) == 1 && query_result["value"]["rows"][0]["right"]["label"] == "match", "Kujo-native evidence query filters and joins bounded JSONL")
delete_file(evidence_left); delete_file(evidence_right)

# Native provider paging accumulates pages while respecting both hard budgets.
paged_probe := pagination_contract_probe()
check(len(paged_probe["rows"]) == 3 && paged_probe["pages_fetched"] == 2 && paged_probe["last_page_requested"] == 1, "provider pagination obeys page and total-row budgets")

print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
