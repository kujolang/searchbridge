mut failed := 0
for directory in ["schemas", "fixtures/providers"] {
	for name in list_dir(directory) {
		if !ends_with(name, ".json") { continue }
		path := directory + "/" + name
		try { parse_json(read_file(path)) }
		except parse_error { failed = failed + 1; eprint("invalid JSON: " + path) }
	}
}
if failed > 0 { exit(1) }
try { parse_yaml(read_file(".github/workflows/validate.yml")) }
except yaml_error { eprint("invalid workflow YAML"); exit(1) }
try { parse_toml(read_file("kujo.toml")) }
except toml_error { eprint("invalid kujo.toml"); exit(1) }
print("JSON, workflow YAML, and project TOML parsed successfully.")
