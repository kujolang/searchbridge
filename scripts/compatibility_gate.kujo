legacy_manifest := parse_json(read_file("fixtures/golden/0.2/manifest.json"))
if legacy_manifest["compatible_series"] != "0.2.x" { eprint("legacy golden compatibility series changed"); exit(1) }
current_manifest := parse_json(read_file("fixtures/golden/1.0/manifest.json"))
if current_manifest["compatible_series"] != "1.x" { eprint("current golden compatibility series changed"); exit(1) }
expected := {
	"result-search-performance.json": "searchbridge.result/v1", "result-analytics.json": "searchbridge.result/v1",
	"result-url-inspection.json": "searchbridge.result/v1", "result-page-performance.json": "searchbridge.result/v1",
	"result-field-performance.json": "searchbridge.result/v1", "result-backlinks.json": "searchbridge.result/v1",
	"result-keyword-data.json": "searchbridge.result/v1", "submission.json": "searchbridge.submission/v1",
	"doctor.json": "searchbridge.doctor/v1", "capabilities.json": "searchbridge.capabilities/v1",
	"providers.json": "searchbridge.providers/v1", "adapter-conformance.json": "searchbridge.adapter-conformance/v1",
	"batch.json": "searchbridge.batch/v1"
}
for name in keys(expected) {
	for series in ["0.2", "1.0"] {
		path := "fixtures/golden/" + series + "/" + name
		if file_exists(path) == false { eprint("missing " + series + " golden document: " + name); exit(1) }
		document := parse_json(read_file(path))
		if document["schema"] != expected[name] { eprint("breaking schema change in " + series + "/" + name); exit(1) }
		if starts_with(name, "result-") && (has_key(document, "rows") == false || has_key(document, "capability") == false || has_key(document, "provider") == false) { eprint("result reader cannot accept " + series + "/" + name); exit(1) }
		if name == "submission.json" && (has_key(document, "authorization") == false || has_key(document, "received") == false || has_key(document, "indexed") == false) { eprint("submission reader cannot accept " + series + " golden document"); exit(1) }
	}
}
print(to_string(len(keys(expected))) + " public contracts pass current 1.x and legacy 0.2.x readers.")
