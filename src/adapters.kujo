			if includes(["offset-limit", "provider-list-window", "page-size"], strategy) || (strategy == "cursor" && dict_get(pagination, "limit_slot", "") != "") { limit_slot := dict_get(pagination, "limit_slot", "body.pagination.limit"); with_limit := set_request_slot(page_body, limit_slot, page_limit); if !with_limit["ok"] { return with_limit }; page_body = with_limit["value"] }
			mut request_options := options; request_options["response_format"] = response["format"]; request_options["max_calls"] = options["max_calls"] - total_telemetry["attempts"]; if request_options["max_calls"] < 1 { return failure("adapter call budget exhausted") }
			fetched_page := request_json(endpoint, request["method"], page_body, headers, request_options, options["transport"]); if !fetched_page["ok"] { return fetched_page }; item_telemetry := fetched_page["value"]["telemetry"]; for field in ["attempts", "retries", "latency_ms", "retry_delay_ms", "response_bytes"] { total_telemetry[field] = total_telemetry[field] + item_telemetry[field] }; total_telemetry["cache_status"] = item_telemetry["cache_status"]; total_telemetry["provider_cost"] = item_telemetry["provider_cost"]
