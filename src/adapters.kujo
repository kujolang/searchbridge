			task_body := posted["value"]["body"]; task_id := json_pointer(task_body, pagination["task_id_pointer"]); if type(task_id) != "string" || !regex_match(task_id, "^[A-Za-z0-9._:-]{1,256}$") { return failure("provider task response omitted a safe task id") }; status := json_pointer(task_body, pagination["status_pointer"]); mut completed_body := null; mut polls := 0; task_started := current_timestamp()
			if status == pagination["completed_value"] { completed_body = json_pointer(task_body, pagination["result_pointer"]) }
			else if status == pagination["failed_value"] { return failure("provider task failed") }
			else if status != pagination["pending_value"] { return failure("provider task returned an unknown status") }
