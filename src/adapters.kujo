			mut poll_headers := {}; if credential_name != "" { mut spec := null; for item in adapter["credentials"] { if item["name"] == credential_name { spec = item } }; bound_results := dict_get(dict_get(spec, "bind", {}), "endpoint_templates", []); if includes(bound_results, result_template) { poll_headers = headers } }
			while type(completed_body) == "null" && polls < options["max_polls"] && total_telemetry["attempts"] < options["max_calls"] && current_timestamp() - task_started <= options["max_elapsed_ms"] {
				poll_interval := dict_get(pagination, "poll_interval_ms", 250); if poll_interval > 0 { sleep(poll_interval) }; request_options["max_calls"] = options["max_calls"] - total_telemetry["attempts"]; request_options["retries"] = 0; polled := request_json(result_endpoint, dict_get(pagination, "poll_method", "GET"), null, poll_headers, request_options, options["transport"]); if !polled["ok"] { return polled }; item_telemetry := polled["value"]["telemetry"]; for field in ["attempts", "retries", "latency_ms", "retry_delay_ms", "response_bytes"] { total_telemetry[field] = total_telemetry[field] + item_telemetry[field] }; total_telemetry["cache_status"] = item_telemetry["cache_status"]; total_telemetry["provider_cost"] = item_telemetry["provider_cost"]; polls = polls + 1; polled_body := polled["value"]["body"]; poll_status := json_pointer(polled_body, pagination["status_pointer"])
				if poll_status == pagination["completed_value"] { completed_body = json_pointer(polled_body, pagination["result_pointer"]) }
				else if poll_status == pagination["failed_value"] { return failure("provider task failed") }
				else if poll_status != pagination["pending_value"] { return failure("provider task returned an unknown status") }
			}
			if type(completed_body) == "null" { return failure("provider task polling budget exceeded") }; async_rows := json_pointer(completed_body, response["rows_pointer"]); if type(async_rows) != "array" { async_rows = [] }; last_body = {"_searchbridge_rows": async_rows}; response["rows_pointer"] = "/_searchbridge_rows"; total_telemetry["pages"] = 1; total_telemetry["task_polls"] = polls; raw_result = success({"body": last_body, "telemetry": total_telemetry})
		} else {
