}

export func run_signed_adapter(options) {
	capabilities := split(options["adapter_allow_capabilities"], ","); endpoints := split(options["adapter_allow_endpoints"], ","); credentials := split(options["adapter_allow_credentials"], ",")
	loaded := load_signed_adapter(options["adapter_manifest"], options["adapter_signature"], options["adapter_key_env"], capabilities, endpoints, credentials)
	if !loaded["ok"] { return loaded }; adapter := loaded["value"]; capability := options["capability"]
	if dict_get(adapter, "contract", "") == "searchbridge-adapter/v2" { return run_signed_adapter_v2(adapter, options) }
	if !includes(adapter["capabilities"], capability) { return failure("adapter does not implement requested capability") }
	request := adapter["request"]; method := dict_get(request, "method", "GET"); endpoint := request["endpoint"]; mut headers := {}
	credential_environment := dict_get(request, "credential_env", "")
	if credential_environment != "" && !options["fixture"] {
		credential := env(credential_environment); if credential == "" { return failure("adapter credential environment variable is unavailable") }
		header_name := dict_get(request, "credential_header", "Authorization"); prefix := dict_get(request, "credential_prefix", "Bearer "); headers[header_name] := prefix + credential
	}
	mut raw_result := null
	if options["fixture"] { raw_result = success({"body": dict_get(adapter, "fixture_response", {"rows": []}), "telemetry": {"attempts": 0, "retries": 0, "latency_ms": 0, "retry_delay_ms": 0, "response_bytes": 0, "cache_status": "fixture", "provider_cost": {}}}) }
	else { raw_result = request_json(endpoint, method, dict_get(request, "body", null), headers, options, options["transport"]) }
	if !raw_result["ok"] { return raw_result }
	body := raw_result["value"]["body"]; rows_field := dict_get(adapter["normalization"], "rows_field", "rows"); rows := dict_get(body, rows_field, [])
	mut run_mode := "live"; if options["fixture"] { run_mode = "fixture" }; mut retrieved_at := now_utc(); if options["deterministic"] { retrieved_at = "1970-01-01T00:00:00Z" }
	return success({"schema": "searchbridge.result/v1", "capability": capability, "provider": adapter["name"], "mode": run_mode, "retrieved_at": retrieved_at, "rows": rows, "adapter_manifest_hash": sha256(read_file(options["adapter_manifest"])), "telemetry": raw_result["value"]["telemetry"]})
}

func includes(values, needle) { for value in values { if value == needle { return true } }; return false }

export func builtin_adapter_contracts() {
	catalog := providers(); mut contracts := {}
	for name in keys(catalog) {
		config := catalog[name]
		contracts[name] := {
			"name": name,
			"capabilities": config["capabilities"],
			"write_capabilities": config["write_capabilities"],
			"cost_class": dict_get(config, "cost_class", "provider-quota"),
			"request_contract": dict_get(config, "request_contract", {}),
			"response_contract": dict_get(config, "response_contract", {})
		}
	}
	return contracts
}

func conformance_options(provider, capability) {
	return {"fixture": true, "offline": true, "replay": false, "deterministic": true, "act": true, "yes": true, "cache_require_encryption": false, "allow_paid": false, "out": "", "timeout": 1.0, "retries": 0, "limit": 100, "page_size": 100, "max_pages": 10, "max_total_rows": 1000, "max_output_bytes": 1048576, "max_output_tokens": 250000, "provider": provider, "property": "https://example.com", "start_date": "2026-09-01", "end_date": "2026-09-02", "dimensions": "date,query,page", "metrics": "sessions,screenPageViews", "url": "https://example.com/", "urls": ["https://example.com/"], "strategy": "mobile", "form_factor": "PHONE", "target": "example.com", "keyword": "kujo language", "country": "US", "location": "United States", "language": "en", "device": "desktop", "operation": "", "route_preferences": "", "enabled_providers": "", "max_providers": 8, "max_calls": 0, "max_provider_units": 0.0, "max_polls": 20, "max_elapsed_ms": 120000, "key_location": "", "endpoint": "", "capability": capability, "current_capability": capability, "transport": null, "format": "json", "cache_dir": "", "cache_max_age": 86400, "cache_encryption_key_env": "", "replay_capabilities": "", "config": "", "profile": "", "health_policy": "info", "degraded_exit_code": 3, "require_capabilities": "", "commands": "", "max_concurrency": 4, "cancel_file": "", "adapter_manifest": "", "adapter_signature": "", "adapter_key_env": "", "adapter_allow_capabilities": "", "adapter_allow_endpoints": "", "adapter_allow_credentials": "", "otel_endpoint": "", "otel_service_name": "searchbridge", "evidence_path": "", "filter_field": "", "filter_equals": "", "join_path": "", "left_field": "", "right_field": "", "adapter_version": ""}
}

func row_schema(capability) {
	mut name := replace(capability, ".", "-"); if capability == "analytics" || capability == "backlinks" { name = capability }; path := "schemas/rows/" + name + ".schema.json"; if !file_exists(path) { return null }; raw := parse_json(read_file(path)); mut schema := {}; for key in keys(raw) { if key != "$schema" && key != "$id" { schema[key] := raw[key] } }; return schema
}

func execute_builtin_fixture(provider, capability) {
	options := conformance_options(provider, capability); routing := {"mode": "conformance", "selected": [provider], "candidates": []}
	if includes(["dataforseo", "serpapi", "cloudflare", "semrush"], provider) { return execute_new_provider(provider, capability, options, routing) }
	if capability == "search.performance" { return command_search_performance(options) }
	if capability == "analytics" { return command_analytics(options) }
	if capability == "url.inspection" { return command_inspect(options) }
	if capability == "page.performance" { return command_pagespeed(options) }
	if capability == "field.performance" { return command_crux(options) }
	if capability == "backlinks" { return command_backlinks(options) }
	if capability == "keyword.data" { return command_keywords(options) }
	if capability == "index.submission" { return command_submit(options) }
	return failure("no conformance executor for capability")
}

export func external_pagination_contract_probe() {
	mut base_options := conformance_options("synthetic-external", "analytics"); base_options["fixture"] = false; base_options["offline"] = false; base_options["max_calls"] = 4; base_options["max_pages"] = 3; base_options["max_polls"] = 2; base_options["page_size"] = 2; base_options["max_total_rows"] = 4; base_options["transport"] = external_pagination_contract_transport
	base_adapter := {"id": "synthetic-external", "adapter_version": "1.0.0", "provider_api_version": "v1", "cost_class": "free", "credentials": [], "retention": {"max_cache_age_seconds": 86400}}
	cursor_operation := {"id": "cursor", "capability": "analytics", "class": "read", "request": {"method": "POST", "endpoint_template": "https://example.invalid/cursor", "allowed_query_fields": [], "body_template": {}, "redirects": "deny"}, "response": {"format": "json", "rows_pointer": "/rows", "max_bytes": 8388608}, "pagination": {"strategy": "cursor", "request_slot": "body.pagination.cursor", "response_pointer": "/next"}, "normalization": {"mapping": [], "row_contract": "analytics/v1"}, "cost": {}}
	mut cursor_adapter := base_adapter; cursor_adapter["operations"] = [cursor_operation]; cursor_result := run_signed_adapter_v2(cursor_adapter, base_options)
	page_operation := {"id": "page", "capability": "analytics", "class": "read", "request": {"method": "POST", "endpoint_template": "https://example.invalid/page", "allowed_query_fields": [], "body_template": {}, "redirects": "deny"}, "response": {"format": "json", "rows_pointer": "/rows", "max_bytes": 8388608}, "pagination": {"strategy": "page-size", "request_slot": "body.pagination.page", "limit_slot": "body.pagination.limit", "page_start": 1}, "normalization": {"mapping": [], "row_contract": "analytics/v1"}, "cost": {}}
	mut page_adapter := base_adapter; page_adapter["operations"] = [page_operation]; page_result := run_signed_adapter_v2(page_adapter, base_options)
	async_operation := {"id": "async", "capability": "analytics", "class": "read", "request": {"method": "POST", "endpoint_template": "https://example.invalid/async/start", "result_endpoint_template": "https://example.invalid/async/result/{task_id}", "allowed_query_fields": [], "body_template": {}, "redirects": "deny"}, "response": {"format": "json", "rows_pointer": "/rows", "max_bytes": 8388608}, "pagination": {"strategy": "async-task", "task_id_pointer": "/task/id", "status_pointer": "/task/status", "result_pointer": "/task/result", "pending_value": "pending", "completed_value": "completed", "failed_value": "failed", "poll_interval_ms": 0}, "normalization": {"mapping": [], "row_contract": "analytics/v1"}, "cost": {}}
	mut async_adapter := base_adapter; async_adapter["operations"] = [async_operation]; async_result := run_signed_adapter_v2(async_adapter, base_options)
	query_operation := {"id": "query", "capability": "analytics", "class": "read", "request": {"method": "GET", "endpoint_template": "https://example.invalid/query", "allowed_query_fields": ["country", "keyword"], "query_template": {"keyword": {"slot": "query.keyword"}, "country": {"slot": "query.country"}}, "redirects": "deny"}, "response": {"format": "json", "rows_pointer": "/rows", "max_bytes": 8388608}, "pagination": {"strategy": "none"}, "normalization": {"mapping": [], "row_contract": "analytics/v1"}, "cost": {}}
	mut query_adapter := base_adapter; query_adapter["operations"] = [query_operation]; query_result := run_signed_adapter_v2(query_adapter, base_options)
	csv_operation := {"id": "csv", "capability": "analytics", "class": "read", "request": {"method": "GET", "endpoint_template": "https://example.invalid/format/csv", "allowed_query_fields": [], "redirects": "deny"}, "response": {"format": "csv", "rows_pointer": "/", "max_bytes": 8388608}, "pagination": {"strategy": "none"}, "normalization": {"mapping": [], "row_contract": "analytics/v1"}, "cost": {}}
	mut csv_adapter := base_adapter; csv_adapter["operations"] = [csv_operation]; csv_probe_result := run_signed_adapter_v2(csv_adapter, base_options)
	graphql_operation := {"id": "graphql", "capability": "analytics", "class": "read", "request": {"method": "GET", "endpoint_template": "https://example.invalid/format/graphql", "allowed_query_fields": [], "redirects": "deny"}, "response": {"format": "graphql-json", "rows_pointer": "/rows", "max_bytes": 8388608}, "pagination": {"strategy": "none"}, "normalization": {"mapping": [], "row_contract": "analytics/v1"}, "cost": {}}
	mut graphql_adapter := base_adapter; graphql_adapter["operations"] = [graphql_operation]; graphql_probe_result := run_signed_adapter_v2(graphql_adapter, base_options)
	return {"cursor": cursor_result, "page": page_result, "async": async_result, "query": query_result, "csv": csv_probe_result, "graphql": graphql_probe_result}
}

export func adapter_behavioral_contract_probe() {
	protocols := external_pagination_contract_probe(); retry := retry_contract_probe()
	empty_operation := {"normalization": {"mapping": [], "row_contract": "analytics/v1"}}; empty_result := normalize_external_rows([], empty_operation, conformance_options("synthetic", "analytics"))
	missing_operation := {"normalization": {"mapping": [{"source": "/missing", "target": "optional", "coerce": "string-or-null"}], "row_contract": "analytics/v1"}}; missing_result := normalize_external_rows([{}], missing_operation, conformance_options("synthetic", "analytics"))
	error_transport := func(_url, _options) { return Ok({"_status": 400, "_body": to_json({"error": "token=should-not-escape"})}) }; provider_error := request_json("https://example.invalid/error", "GET", null, {}, {"offline": false, "timeout": 1, "retries": 0, "deterministic": true}, error_transport)
	cost_transport := func(_url, _options) { return Ok({"_status": 200, "_body": "{}", "_headers": {"x-api-units-cost": "2", "x-api-units-remaining": "8"}}) }; cost_result := request_json("https://example.invalid/cost", "GET", null, {}, {"offline": false, "timeout": 1, "retries": 0, "deterministic": true}, cost_transport)
	mut partial_options := conformance_options("synthetic-external", "analytics"); partial_options["fixture"] = false; partial_options["offline"] = false; partial_options["max_calls"] = 1; partial_options["max_pages"] = 1; partial_options["page_size"] = 2; partial_options["max_total_rows"] = 1; partial_options["transport"] = external_pagination_contract_transport
	partial_adapter := {"id": "synthetic-external", "adapter_version": "1.0.0", "provider_api_version": "v1", "cost_class": "free", "credentials": [], "retention": {"max_cache_age_seconds": 86400}, "operations": [{"id": "partial", "capability": "analytics", "class": "read", "request": {"method": "POST", "endpoint_template": "https://example.invalid/cursor", "allowed_query_fields": [], "body_template": {}, "redirects": "deny"}, "response": {"format": "json", "rows_pointer": "/rows", "max_bytes": 8388608}, "pagination": {"strategy": "cursor", "request_slot": "body.pagination.cursor", "response_pointer": "/next"}, "normalization": {"mapping": [], "row_contract": "analytics/v1"}, "cost": {}}]}; partial_result := run_signed_adapter_v2(partial_adapter, partial_options)
	empty_ok := empty_result["ok"] && len(empty_result["value"]) == 0; missing_ok := missing_result["ok"] && type(missing_result["value"][0]["optional"]) == "null"; partial_ok := partial_result["ok"] && len(partial_result["value"]["rows"]) == 1 && partial_result["value"]["pagination"]["pages_fetched"] == 1; provider_error_ok := !provider_error["ok"] && contains(provider_error["error"], "should-not-escape") == 0; rate_limit_ok := retry["retried"]["ok"] && retry["retried"]["value"]["telemetry"]["attempts"] == 2; pagination_ok := protocols["cursor"]["ok"] && protocols["page"]["ok"] && protocols["async"]["ok"]; bounds_ok := !bounded_csv_parse("name;value\nx;" + repeat("x", 33) + "\n", 2, 4, 32)["ok"]; redaction_ok := !retry["failed"]["ok"] && contains(retry["failed"]["error"], "super-secret") == 0; cost_ok := cost_preflight("metered", false, true, 1, 2)["ok"] && cost_result["ok"] && cost_result["value"]["telemetry"]["provider_cost"]["cost"] == "2"
	return {
		"success": protocols["query"]["ok"],
		"empty": empty_ok, "missing_fields": missing_ok, "partial": partial_ok,
		"provider_error": provider_error_ok, "rate_limit": rate_limit_ok,
		"pagination": pagination_ok, "bounds": bounds_ok, "redaction": redaction_ok, "cost": cost_ok
	}
}

func validate_fixture_result(result, capability) {
	if !result["ok"] || type(result["value"]) != "dict" { return false }
	value := result["value"]; if capability == "index.submission" { return dict_get(value, "schema", "") == "searchbridge.submission/v1" && value["indexed"] == false }
	if dict_get(value, "schema", "") != "searchbridge.result/v1" || type(dict_get(value, "rows", null)) != "array" { return false }
	schema := row_schema(capability); if type(schema) == "null" { return true }; for row in value["rows"] { if !json_schema_validate(row, schema)["valid"] { return false } }; return true
}

export func adapter_conformance_report() {
	registry := adapters(); mut errors := []; mut reports := []; behavioral := adapter_behavioral_contract_probe(); mut behavioral_ok := true; for name in keys(behavioral) { if behavioral[name] != true { behavioral_ok = false; errors = push(errors, "shared runtime behavioral probe failed: " + name) } }
	for name in sort(keys(registry)) {
		adapter := registry[name]; mut adapter_errors := []; mut endpoint_ok := true; mut budgets_ok := true; mut redaction_ok := true; mut fixtures_ok := true; mut discovery_ok := true
		for field in ["contract", "id", "adapter_version", "provider_api_version", "capabilities", "cost_class", "request_contract", "response_contract", "operations"] { if has_key(adapter, field) == 0 { adapter_errors = push(adapter_errors, "missing " + field) } }
		for operation in adapter["operations"] {
			if dict_get(operation, "class", "") != "read" && !includes(adapter["write_capabilities"], operation["capability"]) { adapter_errors = push(adapter_errors, "undeclared write operation") }
			if !starts_with(operation["request"]["endpoint_template"], "https://") || operation["request"]["redirects"] != "deny" { endpoint_ok = false; adapter_errors = push(adapter_errors, "unsafe endpoint policy") }
			if dict_get(operation["response"], "max_bytes", 0) < 1 || dict_get(operation["response"], "max_bytes", 0) > 8388608 || !allowed(["none", "offset-limit", "page-size", "cursor", "provider-list-window", "async-task"], operation["pagination"]["strategy"]) { budgets_ok = false; adapter_errors = push(adapter_errors, operation["id"] + " invalid bounds") }
			for field in dict_get(operation["request"], "allowed_query_fields", []) { if regex_match(field, "(?i)(^|_)(api_?key|token|secret|credential|password|authorization)($|_)") { redaction_ok = false; adapter_errors = push(adapter_errors, operation["id"] + " secret-shaped query field") } }
			if !operation_for(name, operation["capability"])["ok"] { discovery_ok = false; adapter_errors = push(adapter_errors, operation["id"] + " is not discoverable") }
			fixture_result := execute_builtin_fixture(name, operation["capability"]); if !validate_fixture_result(fixture_result, operation["capability"]) { fixtures_ok = false; adapter_errors = push(adapter_errors, operation["id"] + " fixture execution failed conformance") }
		}
		for error in adapter_errors { errors = push(errors, name + " " + error) }
		report_ok := len(adapter_errors) == 0 && behavioral_ok; report_redaction := redaction_ok && behavioral["redaction"]; manifest_ok := len(adapter_errors) == 0
		reports = push(reports, {"adapter_id": name, "adapter_version": adapter["adapter_version"], "external": false, "ok": report_ok, "checks": {"manifest": manifest_ok, "discovery": discovery_ok, "endpoint": endpoint_ok, "budgets": budgets_ok, "redaction": report_redaction, "fixture": fixtures_ok, "behavioral": behavioral}})
	}
	plausible_text := read_file("adapters/plausible/adapter.json"); plausible := parse_json(plausible_text); plausible_checked := validate_adapter_v2(plausible); signature_ok := rsa_verify(plausible_text, trim(read_file("adapters/plausible/adapter.sig")), read_file("adapters/plausible/trust-key.pem")); fixture_body := parse_json(read_file("adapters/plausible/" + plausible["operations"][0]["fixture"])); fixture_rows := json_pointer(fixture_body, plausible["operations"][0]["response"]["rows_pointer"]); normalized := normalize_external_rows(fixture_rows, plausible["operations"][0], conformance_options("plausible", "analytics")); fixture_ok := normalized["ok"] && validate_fixture_result(success({"schema": "searchbridge.result/v1", "rows": normalized["value"]}), "analytics")
	if !plausible_checked["ok"] { for error in plausible_checked["errors"] { errors = push(errors, "plausible " + error) } }
	if !signature_ok { errors = push(errors, "plausible signature verification failed") }; if !fixture_ok { errors = push(errors, "plausible fixture normalization failed") }; mut write_probe := plausible; mut write_operation := plausible["operations"][0]; write_operation["class"] = "write"; write_probe["operations"] = [write_operation]; external_write_rejection := !validate_adapter_v2(write_probe)["ok"]
	plausible_manifest_ok := plausible_checked["ok"] && signature_ok; plausible_discovery_ok := len(plausible["capabilities"]) > 0; plausible_endpoint_ok := starts_with(plausible["operations"][0]["request"]["endpoint_template"], "https://"); plausible_budgets_ok := plausible["operations"][0]["response"]["max_bytes"] <= 8388608; plausible_ok := plausible_manifest_ok && fixture_ok && external_write_rejection
	external_ok := plausible_ok && behavioral_ok; reports = push(reports, {"adapter_id": "plausible", "adapter_version": plausible["adapter_version"], "external": true, "ok": external_ok, "checks": {"manifest": plausible_manifest_ok, "discovery": plausible_discovery_ok, "endpoint": plausible_endpoint_ok, "budgets": plausible_budgets_ok, "redaction": behavioral["redaction"], "fixture": fixture_ok, "behavioral": behavioral, "external_write_rejection": external_write_rejection}})
	return {"schema": "searchbridge.adapter-conformance/v1", "ok": len(errors) == 0, "adapter_count": len(reports), "errors": errors, "reports": reports}
}
