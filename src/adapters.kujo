			if includes(["offset-limit", "provider-list-window"], strategy) { slot := dict_get(pagination, "request_slot", ""); with_offset := set_request_slot(page_body, slot, offset); if !with_offset["ok"] { return with_offset }; page_body = with_offset["value"] }
			if strategy == "page-size" { slot := dict_get(pagination, "request_slot", ""); with_page := set_request_slot(page_body, slot, page + dict_get(pagination, "page_start", 1)); if !with_page["ok"] { return with_page }; page_body = with_page["value"] }
