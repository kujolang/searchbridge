from src.core import VERSION, dict_get, failure, success, providers, query_encode, query_fingerprint
from src.registry import adapters, operation_for
from src.transport import request_json, external_pagination_contract_transport, retry_contract_probe
from src.protocols import validate_exact_endpoint, validate_template_endpoint, graphql_result, cost_preflight, bounded_csv_parse
from src.commands import command_search_performance, command_analytics, command_inspect, command_pagespeed, command_crux, command_backlinks, command_keywords, command_submit
from src.provider_runtime import execute_new_provider

export func required_adapter_fields() {
	return ["name", "capabilities", "write_capabilities", "cost_class", "request_contract", "response_contract", "discovery", "request", "normalization", "write_boundary"]
}

export func validate_adapter(adapter) {
	if type(adapter) != "dict" { return failure("adapter must be a dictionary") }
	if dict_get(adapter, "contract", "") == "searchbridge-adapter/v2" { return validate_adapter_v2(adapter) }
	mut errors := []
	for field in required_adapter_fields() { if has_key(adapter, field) == false { errors = push(errors, "missing " + field) } }
	if has_key(adapter, "name") && (type(adapter["name"]) != "string" || trim(adapter["name"]) == "") { errors = push(errors, "name must be non-empty") }
	if has_key(adapter, "capabilities") && len(adapter["capabilities"]) == 0 { errors = push(errors, "capabilities must be non-empty") }
	for hook in ["discovery", "request", "normalization", "write_boundary"] { if has_key(adapter, hook) && type(adapter[hook]) != "dict" { errors = push(errors, hook + " must be a declarative table") } }
	return {"ok": len(errors) == 0, "errors": errors}
}

func allowed(values, value) { for item in values { if item == value { return true } }; return false }

export func canonical_json(value) {
	if type(value) == "dict" { mut members := []; for key in sort(keys(value)) { members = push(members, to_json(key) + ":" + canonical_json(value[key])) }; return "{" + join(members, ",") + "}" }
	if type(value) == "list" { mut members := []; for item in value { members = push(members, canonical_json(item)) }; return "[" + join(members, ",") + "]" }
	return to_json(value)
}

export func validate_adapter_v2(adapter) {
	if type(adapter) != "dict" { return failure("adapter must be a dictionary") }
	mut errors := []
	for field in ["contract", "id", "adapter_version", "provider_api_version", "minimum_searchbridge_version", "capabilities", "operations", "credentials", "cost_class", "fixtures", "publisher", "signature"] { if has_key(adapter, field) == 0 { errors = push(errors, "missing " + field) } }
	if dict_get(adapter, "contract", "") != "searchbridge-adapter/v2" { errors = push(errors, "unsupported adapter contract") }
	if !regex_match(dict_get(adapter, "id", ""), "^[a-z][a-z0-9-]*$") { errors = push(errors, "invalid adapter id") }
	if !regex_match(dict_get(adapter, "adapter_version", ""), "^[0-9]+\\.[0-9]+\\.[0-9]+$") || dict_get(adapter, "minimum_searchbridge_version", "") != "0.4.0" { errors = push(errors, "unknown adapter or minimum runtime version") }
	if !allowed(["free", "quota", "metered", "expensive", "unknown"], dict_get(adapter, "cost_class", "")) { errors = push(errors, "unknown cost class") }
	for credential in dict_get(adapter, "credentials", []) {
		if !allowed(["none", "bearer", "header", "basic", "query", "body"], dict_get(credential, "mode", "")) { errors = push(errors, "unknown credential mode") }
		if !regex_match(dict_get(credential, "name", ""), "^[A-Z][A-Z0-9_]*$") { errors = push(errors, "invalid credential environment name") }
		if !starts_with(dict_get(dict_get(credential, "bind", {}), "endpoint_template", ""), "https://") { errors = push(errors, "credential binding must use an exact HTTPS endpoint template") }
		if allowed(["header", "query", "body"], dict_get(credential, "mode", "")) && !regex_match(dict_get(credential, "field", ""), "^[A-Za-z][A-Za-z0-9_-]{0,63}$") { errors = push(errors, "credential field name is invalid") }
		for endpoint in dict_get(dict_get(credential, "bind", {}), "endpoint_templates", []) { if !starts_with(endpoint, "https://") || contains(endpoint, "@") || contains(endpoint, "#") { errors = push(errors, "credential result binding is invalid") } }
	}
	mut operation_ids := []
	for operation in dict_get(adapter, "operations", []) {
		id := dict_get(operation, "id", ""); if allowed(operation_ids, id) { errors = push(errors, "duplicate operation id") }; operation_ids = push(operation_ids, id)
		if dict_get(operation, "class", "") != "read" { errors = push(errors, "external adapters are read-only") }
		if !allowed(["json", "csv", "graphql-json"], dict_get(dict_get(operation, "response", {}), "format", "")) { errors = push(errors, "unknown response format") }
		if !allowed(["none", "offset-limit", "page-size", "cursor", "provider-list-window", "async-task"], dict_get(dict_get(operation, "pagination", {}), "strategy", "")) { errors = push(errors, "unknown pagination strategy") }
		request := dict_get(operation, "request", {}); endpoint := dict_get(request, "endpoint_template", "")
		if !starts_with(endpoint, "https://") || contains(endpoint, "@") || contains(endpoint, "#") { errors = push(errors, "operation endpoint must be an exact safe HTTPS template") }
		if dict_get(request, "redirects", "") != "deny" { errors = push(errors, "external adapter redirects must be denied") }
		query_template := dict_get(request, "query_template", {}); if type(query_template) != "dict" { errors = push(errors, "query template must be an object") } else { for key in keys(query_template) { if !includes(dict_get(request, "allowed_query_fields", []), key) || !regex_match(key, "^[A-Za-z][A-Za-z0-9_.-]{0,63}$") { errors = push(errors, "query template field is not declared or safe") } } }
		credential_name := dict_get(request, "credential", ""); if credential_name != "" { mut bound := false; for credential in dict_get(adapter, "credentials", []) { if credential["name"] == credential_name { bind := credential["bind"]; bound = dict_get(bind, "endpoint_template", "") == endpoint || includes(dict_get(bind, "endpoint_templates", []), endpoint) } }; if !bound { errors = push(errors, "operation credential is undeclared or not bound to its exact endpoint") } }
		response := dict_get(operation, "response", {}); if dict_get(response, "max_bytes", 0) < 1 || dict_get(response, "max_bytes", 0) > 8388608 { errors = push(errors, "response byte bound is invalid") }
		reliability := dict_get(operation, "reliability", {}); if type(reliability) != "dict" { errors = push(errors, "operation reliability policy must be an object") } else { if dict_get(reliability, "max_retries", 0) < 0 || dict_get(reliability, "max_retries", 0) > 5 { errors = push(errors, "operation retry bound is invalid") }; if dict_get(reliability, "circuit_failure_threshold", 1) < 1 || dict_get(reliability, "circuit_failure_threshold", 1) > 10 { errors = push(errors, "operation circuit threshold is invalid") }; for status in dict_get(reliability, "retry_statuses", []) { if !includes([429, 500, 502, 503, 504], status) { errors = push(errors, "operation retry status is unsafe") } } }
		pagination := dict_get(operation, "pagination", {}); strategy := dict_get(pagination, "strategy", "")
		if includes(["offset-limit", "page-size", "provider-list-window"], strategy) && (!starts_with(dict_get(pagination, "request_slot", ""), "body.") || !starts_with(dict_get(pagination, "limit_slot", ""), "body.")) { errors = push(errors, strategy + " pagination requires body request and limit slots") }
		if strategy == "cursor" && (!starts_with(dict_get(pagination, "request_slot", ""), "body.") || !starts_with(dict_get(pagination, "response_pointer", ""), "/")) { errors = push(errors, "cursor pagination requires request slot and response pointer") }
		if strategy == "async-task" {
			result_template := dict_get(request, "result_endpoint_template", ""); if !starts_with(result_template, "https://") || contains(result_template, "{task_id}") == 0 { errors = push(errors, "async task requires an exact result endpoint template") }
			for field in ["task_id_pointer", "status_pointer", "result_pointer"] { if !starts_with(dict_get(pagination, field, ""), "/") { errors = push(errors, "async task " + field + " is invalid") } }
			if dict_get(pagination, "pending_value", "") == "" || dict_get(pagination, "completed_value", "") == "" || dict_get(pagination, "failed_value", "") == "" { errors = push(errors, "async task status values are incomplete") }
			poll_interval := dict_get(pagination, "poll_interval_ms", 250); if poll_interval < 0 || poll_interval > 5000 { errors = push(errors, "async task poll interval is invalid") }
		}
		for rule in dict_get(dict_get(operation, "normalization", {}), "mapping", []) {
			if !regex_match(dict_get(rule, "target", ""), "^[a-z][a-z0-9_]*$") || (!starts_with(dict_get(rule, "source", ""), "/") && !starts_with(dict_get(rule, "source", ""), "$query.")) { errors = push(errors, "normalization mapping is invalid") }
			if !allowed(["string", "string-or-null", "number", "number-or-null", "integer", "integer-or-null", "boolean", "boolean-or-null", "uri-or-null"], dict_get(rule, "coerce", "")) { errors = push(errors, "normalization coercion is invalid") }
		}
	}
	signature := dict_get(adapter, "signature", {}); if dict_get(signature, "algorithm", "") != "rsa-sha256" || dict_get(signature, "canonicalization", "") != "jcs" { errors = push(errors, "unknown signature algorithm or canonicalization") }
	if len(errors) == 0 { schema_check := json_schema_validate(adapter, parse_json(read_file("schemas/adapter-manifest-v2.schema.json"))); if !schema_check["valid"] { errors = push(errors, "adapter manifest does not satisfy v2 schema") } }
	return {"ok": len(errors) == 0, "errors": errors}
}

func safe_package_path(relative) { return relative != "" && !starts_with(relative, "/") && contains(relative, "..") == 0 && contains(relative, "\\") == 0 }

export func load_signed_adapter_v2(manifest_path, signature_path, key_environment, capability_allowlist, endpoint_allowlist, credential_allowlist) {
	if manifest_path == "" || signature_path == "" || key_environment == "" { return failure("signed adapters require manifest, signature, and trust key") }
	key := env(key_environment); if key == "" { return failure("adapter signature key environment variable is unavailable") }
	try {
		manifest_text := read_file(manifest_path); adapter := parse_json(manifest_text)
		if canonical_json(adapter) != trim(manifest_text) { return failure("adapter manifest is not canonical JSON") }
		if rsa_verify(manifest_text, trim(read_file(signature_path)), key) != true { return failure("adapter package RSA-SHA256 signature verification failed") }
		checked := validate_adapter_v2(adapter); if !checked["ok"] { return failure(join(checked["errors"], "; ")) }
		expected_fingerprint := dict_get(dict_get(adapter, "publisher", {}), "key_fingerprint", ""); if expected_fingerprint != "sha256:" + sha256(trim(key)) { return failure("adapter publisher trust-key fingerprint mismatch") }
		base := dirname(manifest_path)
		for file in dict_get(adapter, "package_files", []) {
			relative := dict_get(file, "path", ""); if !safe_package_path(relative) { return failure("unsafe adapter package path") }
			path := path_join(base, relative); if !path_is_file(path) || path_is_symlink(path) { return failure("adapter package file is missing or unsafe") }
			if sha256_file(path) != dict_get(file, "sha256", "") { return failure("adapter package file digest mismatch") }
		}
		for capability in adapter["capabilities"] { if !includes(capability_allowlist, capability["id"]) { return failure("adapter capability is not allowlisted: " + capability["id"]) } }
		for operation in adapter["operations"] {
			endpoint := operation["request"]["endpoint_template"]; if !includes(endpoint_allowlist, endpoint) { return failure("adapter endpoint is not allowlisted") }
			result_endpoint := dict_get(operation["request"], "result_endpoint_template", ""); if result_endpoint != "" && !includes(endpoint_allowlist, result_endpoint) { return failure("adapter result endpoint is not allowlisted") }
		}
		for credential in adapter["credentials"] { if !includes(credential_allowlist, credential["name"]) { return failure("adapter credential environment variable is not allowlisted") }; for endpoint in dict_get(dict_get(credential, "bind", {}), "endpoint_templates", []) { if !includes(endpoint_allowlist, endpoint) { return failure("adapter credential result binding is not endpoint-allowlisted") } } }
		return success(adapter)
	} except adapter_error { return failure("could not load signed adapter package: " + to_string(adapter_error)) }
}

export func register_adapter(registry, adapter) {
	checked := validate_adapter(adapter)
	if !checked["ok"] { return failure(join(checked["errors"], "; ")) }
	mut updated := registry
	updated[adapter["name"]] := adapter
	return success(updated)
}

export func execute_adapter(registry, name, capability, options) {
	if has_key(registry, name) == false { return failure("adapter not registered: " + name) }
	adapter := registry[name]
	if !includes(adapter["capabilities"], capability) { return failure("adapter does not implement capability: " + capability) }
	return success({"adapter": name, "capability": capability, "cost_class": adapter["cost_class"], "discovery": adapter["discovery"], "request": adapter["request"], "normalization": adapter["normalization"], "write_boundary": adapter["write_boundary"], "options": options})
}

export func load_signed_adapter(manifest_path, signature_path, key_environment, capability_allowlist, endpoint_allowlist, credential_allowlist) {
	if manifest_path == "" || signature_path == "" || key_environment == "" { return failure("signed adapters require --adapter-manifest, --adapter-signature, and --adapter-key-env") }
	key := env(key_environment); if key == "" { return failure("adapter signature key environment variable is unavailable") }
	try {
		manifest_text := read_file(manifest_path)
		preview := parse_json(manifest_text)
		if dict_get(preview, "contract", "") == "searchbridge-adapter/v2" { return load_signed_adapter_v2(manifest_path, signature_path, key_environment, capability_allowlist, endpoint_allowlist, credential_allowlist) }
		signature := trim(read_file(signature_path))
		if rsa_verify(manifest_text, signature, key) != true { return failure("adapter manifest RSA-SHA256 signature verification failed") }
		adapter := parse_json(manifest_text); checked := validate_adapter(adapter); if !checked["ok"] { return failure(join(checked["errors"], "; ")) }
		schema_check := json_schema_validate(adapter, parse_json(read_file("schemas/adapter-manifest.schema.json"))); if !schema_check["valid"] { return failure("adapter manifest does not satisfy its schema") }
		for capability in adapter["capabilities"] { if !includes(capability_allowlist, capability) { return failure("adapter capability is not allowlisted: " + capability) } }
		endpoint := dict_get(adapter["request"], "endpoint", ""); if !includes(endpoint_allowlist, endpoint) { return failure("adapter endpoint is not allowlisted") }
		credential_environment := dict_get(adapter["request"], "credential_env", "")
		if credential_environment != "" && !includes(credential_allowlist, credential_environment) { return failure("adapter credential environment variable is not allowlisted") }
		return success(adapter)
	} except adapter_error { return failure("could not load signed adapter: " + to_string(adapter_error)) }
}

func json_pointer(value, pointer) {
	if pointer == "" || pointer == "/" { return value }
	mut current := value
	for raw in split(pointer, "/") {
		if raw == "" { continue }; key := replace(replace(raw, "~1", "/"), "~0", "~")
		if type(current) == "dict" && has_key(current, key) { current = current[key] }
		else if type(current) == "array" && regex_match(key, "^[0-9]+$") && to_int(key) < len(current) { current = current[to_int(key)] }
		else { return null }
	}
	return current
}

func external_v2_operation(adapter, capability) { for operation in adapter["operations"] { if operation["capability"] == capability { return operation } }; return null }

func safe_query_slot(name) { return includes(["property", "start_date", "end_date", "dimensions", "metrics", "url", "target", "keyword", "country", "location", "language", "device", "operation", "page_size", "max_total_rows"], name) }

func materialize_template(value, options) {
	if type(value) == "dict" && has_key(value, "slot") {
		slot := value["slot"]; if !starts_with(slot, "query.") { return failure("adapter template slot must reference a safe query field") }; name := substring(slot, 6, len(slot)); if !safe_query_slot(name) { return failure("adapter template references an unsupported query field") }
		resolved := dict_get(options, name, ""); transform := dict_get(value, "transform", "identity")
		if transform == "csv-list" { mut items := []; for raw in split(to_string(resolved), ",") { item := trim(raw); if item != "" { items = push(items, item) } }; return success(items) }
		if transform != "identity" { return failure("adapter template uses an unsupported transform") }
		return success(resolved)
	}
	if type(value) == "dict" { mut output := {}; for key in keys(value) { built := materialize_template(value[key], options); if !built["ok"] { return built }; output[key] := built["value"] }; return success(output) }
	if type(value) == "array" { mut output := []; for item in value { built := materialize_template(item, options); if !built["ok"] { return built }; output = push(output, built["value"]) }; return success(output) }
	return success(value)
}

func validate_body_fields(body, allowed_fields) {
	if type(body) == "null" { return success(true) }
	if type(body) != "dict" { return failure("adapter request body must be an object") }
	for key in keys(body) { if !includes(allowed_fields, key) && key != "pagination" { return failure("adapter request body field is not declared: " + key) } }
	return success(true)
}

func append_query_template(endpoint, template, allowed_fields, options) {
	if type(template) != "dict" { return failure("adapter query template must be an object") }
	mut pairs := []
	for key in sort(keys(template)) {
		if !includes(allowed_fields, key) || !regex_match(key, "^[A-Za-z][A-Za-z0-9_.-]{0,63}$") { return failure("adapter query field is not declared: " + key) }
		built := materialize_template(template[key], options); if !built["ok"] { return built }; value := built["value"]
		if type(value) == "array" { for item in value { pairs = push(pairs, query_encode(key) + "=" + query_encode(to_string(item))) } }
		else if type(value) != "null" && to_string(value) != "" { pairs = push(pairs, query_encode(key) + "=" + query_encode(to_string(value))) }
	}
	if len(pairs) == 0 { return success(endpoint) }
	return success(endpoint + "?" + join(pairs, "&"))
}

func set_request_slot(body, slot, value) {
	if !starts_with(slot, "body.") { return failure("adapter pagination slot must target the request body") }
	parts := split(substring(slot, 5, len(slot)), "."); if len(parts) == 0 || len(parts) > 3 { return failure("adapter pagination slot is invalid") }
	for part in parts { if !regex_match(part, "^[a-z][a-z0-9_]*$") { return failure("adapter pagination slot is invalid") } }
	mut base := body; if type(base) == "null" { base = {} }
	if len(parts) == 1 { base[parts[0]] = value; return success(base) }
	mut level_one := dict_get(base, parts[0], {}); if type(level_one) != "dict" { level_one = {} }
	if len(parts) == 2 { level_one[parts[1]] = value; base[parts[0]] = level_one; return success(base) }
	mut level_two := dict_get(level_one, parts[1], {}); if type(level_two) != "dict" { level_two = {} }; level_two[parts[2]] = value; level_one[parts[1]] = level_two; base[parts[0]] = level_one; return success(base)
}

func coerce_mapping(value, kind) {
	if kind == "string" { if type(value) == "null" { return failure("required adapter mapping value is missing") }; return success(to_string(value)) }
	if includes(["string-or-null", "uri-or-null"], kind) { if type(value) == "null" { return success(null) }; text := to_string(value); if kind == "uri-or-null" && !starts_with(text, "https://") && !starts_with(text, "http://") { return failure("adapter mapping produced an invalid URI") }; return success(text) }
	if includes(["number", "number-or-null"], kind) { if type(value) == "null" && kind == "number-or-null" { return success(null) }; if type(value) != "int" && type(value) != "float" { return failure("adapter mapping expected a number") }; return success(value) }
	if includes(["integer", "integer-or-null"], kind) { if type(value) == "null" && kind == "integer-or-null" { return success(null) }; if type(value) == "int" { return success(value) }; if type(value) == "string" && regex_match(value, "^-?[0-9]+$") { return success(to_int(value)) }; return failure("adapter mapping expected an integer") }
	if includes(["boolean", "boolean-or-null"], kind) { if type(value) == "null" && kind == "boolean-or-null" { return success(null) }; if type(value) != "bool" { return failure("adapter mapping expected a boolean") }; return success(value) }
	return failure("adapter mapping uses an unsupported coercion")
}

func normalize_external_rows(rows, operation, options) {
	mapping := dict_get(operation["normalization"], "mapping", []); if len(mapping) == 0 { return success(rows) }; mut normalized := []
	for source_row in rows {
		mut output := {}
		for rule in mapping {
			source := rule["source"]; mut raw := null
			if starts_with(source, "$query.") { name := substring(source, 7, len(source)); if !safe_query_slot(name) { return failure("adapter normalization references an unsupported query field") }; raw = dict_get(options, name, null) }
			else { raw = json_pointer(source_row, source) }
			coerced := coerce_mapping(raw, rule["coerce"]); if !coerced["ok"] { return coerced }; output[rule["target"]] := coerced["value"]
		}
		normalized = push(normalized, output)
	}
	return success(normalized)
}

func run_signed_adapter_v2(adapter, options) {
	capability := options["capability"]; operation := external_v2_operation(adapter, capability)
	if type(operation) == "null" { return failure("adapter does not implement requested capability") }
	options["provider"] = adapter["id"]; options["adapter_version"] = adapter["adapter_version"]; retention_cap := dict_get(dict_get(adapter, "retention", {}), "max_cache_age_seconds", 86400); if (options["cache_dir"] != "" || options["replay"]) && options["cache_max_age"] > retention_cap { return failure("adapter retention policy caps cache age") }; preflight := cost_preflight(adapter["cost_class"], options["fixture"], options["allow_paid"], options["max_calls"], options["max_provider_units"]); if !preflight["ok"] { return preflight }
	reliability := dict_get(operation, "reliability", {}); max_retries := dict_get(reliability, "max_retries", options["retries"]); if options["retries"] > max_retries { options["retries"] = max_retries }; options["retry_statuses"] = dict_get(reliability, "retry_statuses", [429, 500, 502, 503, 504]); options["retry_delay_cap_ms"] = dict_get(reliability, "retry_delay_cap_ms", 5000); options["circuit_failure_threshold"] = dict_get(reliability, "circuit_failure_threshold", 3)
	mut raw_result := null; base := dirname(options["adapter_manifest"]); request := operation["request"]; response := operation["response"]; pagination := operation["pagination"]
	if options["fixture"] {
		fixture_path := path_join(base, operation["fixture"]); raw_result = success({"body": parse_json(read_file(fixture_path)), "telemetry": {"attempts": 0, "retries": 0, "latency_ms": 0, "retry_delay_ms": 0, "response_bytes": 0, "cache_status": "fixture", "provider_cost": {}}})
	} else {
		endpoint := request["endpoint_template"]; mut headers := {}; allowed_fields := dict_get(request, "allowed_query_fields", []); template := dict_get(request, "body_template", dict_get(request, "body", null)); built_body := materialize_template(template, options); if !built_body["ok"] { return built_body }; mut body := built_body["value"]; body_fields := validate_body_fields(body, allowed_fields); if !body_fields["ok"] { return body_fields }; built_endpoint := append_query_template(endpoint, dict_get(request, "query_template", {}), allowed_fields, options); if !built_endpoint["ok"] { return built_endpoint }; endpoint = built_endpoint["value"]; mut auth_mode := "none"
		credential_name := dict_get(request, "credential", "")
			if credential_name != "" {
				mut credential_spec := null; for item in adapter["credentials"] { if item["name"] == credential_name { credential_spec = item } }
				if type(credential_spec) == "null" { return failure("operation credential is undeclared") }
				bind := credential_spec["bind"]; if dict_get(bind, "endpoint_template", "") != request["endpoint_template"] && !includes(dict_get(bind, "endpoint_templates", []), request["endpoint_template"]) { return failure("operation credential is not bound to its exact endpoint") }
				credential := env(credential_name); if credential == "" { return failure("adapter credential environment variable is unavailable") }
			mode := credential_spec["mode"]; auth_mode = mode
			if mode == "bearer" { headers["Authorization"] := "Bearer " + credential }
			else if mode == "header" { headers[credential_spec["field"]] := credential }
			else if mode == "basic" { headers["Authorization"] := "Basic " + encode_base64(credential) }
			else if mode == "query" { separator := "?"; if contains(endpoint, "?") { separator = "&" }; endpoint = endpoint + separator + query_encode(credential_spec["field"]) + "=" + query_encode(credential) }
			else if mode == "body" { if type(body) == "null" { body = {} }; body[credential_spec["field"]] := credential }
		}
		checked_endpoint := validate_exact_endpoint(endpoint, request["endpoint_template"], contains(endpoint, "?")); if !checked_endpoint["ok"] { return checked_endpoint }
		strategy := pagination["strategy"]; mut page := 0; mut offset := 0; mut cursor := ""; mut seen_cursors := []; mut rows_seen := 0; mut accumulated := []; mut total_telemetry := {"attempts": 0, "retries": 0, "latency_ms": 0, "retry_delay_ms": 0, "response_bytes": 0, "cache_status": "disabled", "provider_cost": {}}; mut last_body := null
		if strategy == "async-task" {
