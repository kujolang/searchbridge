from src.core import VERSION, failure, clean_error, dict_get, utf8_size, csv_values, query_fingerprint, run_identifier, provenance_record
from src.commands import static_command, command_search_performance, command_analytics, command_inspect, command_pagespeed, command_crux, command_backlinks, command_keywords, command_submit
from src.config import load_profile, environment_overrides
from src.adapters import adapter_conformance_report, run_signed_adapter
from src.evidence import query_evidence
from src.telemetry import export_otel
from src.registry import resolve, operation_for, adapters
from src.provider_runtime import execute_new_provider
from src.cache import maintain_cache

func bool_flags() { return ["fixture", "offline", "replay", "resume-task", "deterministic", "act", "yes", "cache-require-encryption", "allow-paid", "allow-unverified-live"] }
func value_flags() { return ["out", "timeout", "retries", "limit", "page-size", "max-pages", "max-total-rows", "max-output-bytes", "max-output-tokens", "provider", "property", "start-date", "end-date", "dimensions", "metrics", "url", "strategy", "form-factor", "target", "keyword", "country", "location", "language", "device", "operation", "route-preferences", "enabled-providers", "max-providers", "max-calls", "max-provider-units", "max-polls", "max-elapsed-ms", "key-location", "endpoint", "capability", "format", "cache-dir", "cache-max-age", "cache-encryption-key-env", "replay-capabilities", "cache-action", "cache-old-key-env", "cache-new-key-env", "task-state-dir", "task-state-max-age", "config", "profile", "health-policy", "degraded-exit-code", "require-capabilities", "commands", "max-concurrency", "cancel-file", "adapter-manifest", "adapter-signature", "adapter-key-env", "adapter-allow-capabilities", "adapter-allow-endpoints", "adapter-allow-credentials", "otel-endpoint", "otel-service-name", "evidence-path", "filter-field", "filter-equals", "join-path", "left-field", "right-field", "join-strategy", "join-temp-dir", "max-join-disk-bytes"] }

func includes(values, needle) { for value in values { if value == needle { return true } }; return false }
func apply_reliability(options, operation) { policy := dict_get(operation, "reliability", {}); max_retries := dict_get(policy, "max_retries", options["retries"]); if options["retries"] > max_retries { options["retries"] = max_retries }; options["retry_statuses"] = dict_get(policy, "retry_statuses", [429, 500, 502, 503, 504]); options["retry_delay_cap_ms"] = dict_get(policy, "retry_delay_cap_ms", 5000); options["circuit_failure_threshold"] = dict_get(policy, "circuit_failure_threshold", 3); return options }
func commands() { return ["doctor", "capabilities", "providers", "agent-catalog", "version", "adapter-conformance", "adapter-run", "evidence-query", "cache-maintenance", "batch", "fetch", "search-performance", "analytics", "inspect-url", "pagespeed", "crux", "backlinks", "keyword-data", "submit"] }

func default_options() {
	return {
		"fixture": false, "offline": false, "replay": false, "resume_task": false, "deterministic": false, "act": false, "yes": false, "cache_require_encryption": false, "allow_paid": false, "allow_unverified_live": false,
		"out": "", "timeout": 30.0, "retries": 2, "limit": 100, "page_size": 100, "max_pages": 10, "max_total_rows": 1000,
		"max_output_bytes": 1048576, "max_output_tokens": 250000,
		"provider": "", "property": "", "start_date": "", "end_date": "",
		"dimensions": "", "metrics": "", "url": "", "urls": [],
		"strategy": "mobile", "form_factor": "PHONE", "target": "", "keyword": "",
		"country": "US", "location": "United States", "language": "en", "device": "desktop", "operation": "", "route_preferences": "", "enabled_providers": "", "max_providers": 8, "max_calls": 0, "max_provider_units": 0.0, "max_polls": 20, "max_elapsed_ms": 120000, "key_location": "", "endpoint": "", "capability": "", "transport": null,
		"format": "json", "cache_dir": "", "cache_max_age": 86400, "cache_encryption_key_env": "", "replay_capabilities": "", "cache_action": "audit", "cache_old_key_env": "", "cache_new_key_env": "", "task_state_dir": "", "task_state_max_age": 86400, "config": "", "profile": "", "health_policy": "info", "degraded_exit_code": 3, "require_capabilities": "", "commands": "", "max_concurrency": 4, "cancel_file": "",
		"adapter_manifest": "", "adapter_signature": "", "adapter_key_env": "", "adapter_allow_capabilities": "", "adapter_allow_endpoints": "", "adapter_allow_credentials": "",
		"otel_endpoint": "", "otel_service_name": "searchbridge", "evidence_path": "", "filter_field": "", "filter_equals": "", "join_path": "", "left_field": "", "right_field": "", "join_strategy": "auto", "join_temp_dir": "", "max_join_disk_bytes": 67108864
	}
}

func option_key(name) { return replace(name, "-", "_") }

export func parse_options(tokens) {
	mut options := default_options()
	mut seen := []
	mut i := 0
	while i < len(tokens) {
		token := tokens[i]
		if !starts_with(token, "--") { return failure("unexpected positional argument: " + token) }
		mut raw := substring(token, 2, len(token)); mut inline_value := ""; mut has_inline := false
		equals := index_of(raw, "=")
		if equals >= 0 { inline_value = substring(raw, equals + 1, len(raw)); raw = substring(raw, 0, equals); has_inline = true }
		if includes(bool_flags(), raw) {
			if has_inline { return failure("option --" + raw + " does not take a value") }
			options[option_key(raw)] = true; seen = push(seen, option_key(raw))
		} else if includes(value_flags(), raw) {
			mut value := inline_value
			if !has_inline {
				if i + 1 >= len(tokens) || starts_with(tokens[i + 1], "--") { return failure("missing value for --" + raw) }
				i = i + 1; value = tokens[i]
			}
			if value == "" { return failure("missing value for --" + raw) }
			if raw == "url" { options["urls"] = push(options["urls"], value); options["url"] = value }
			else {
				if includes(seen, option_key(raw)) { return failure("duplicate option --" + raw) }
				options[option_key(raw)] = value; seen = push(seen, option_key(raw))
			}
		} else { return failure("unknown option --" + raw) }
		i = i + 1
	}
	profile := load_profile(options["config"], options["profile"]); if !profile["ok"] { return profile }
	for key in keys(profile["value"]) { if !includes(seen, key) { options[key] = profile["value"][key] } }
	for key in keys(environment_overrides()) { if !includes(seen, key) { options[key] = environment_overrides()[key] } }
	try {
		options["timeout"] = to_float(options["timeout"])
		options["retries"] = to_int(options["retries"])
		options["limit"] = to_int(options["limit"])
		options["page_size"] = to_int(options["page_size"]); options["max_pages"] = to_int(options["max_pages"]); options["max_total_rows"] = to_int(options["max_total_rows"])
		options["max_output_bytes"] = to_int(options["max_output_bytes"])
		options["max_output_tokens"] = to_int(options["max_output_tokens"])
		options["cache_max_age"] = to_int(options["cache_max_age"]); options["task_state_max_age"] = to_int(options["task_state_max_age"]); options["degraded_exit_code"] = to_int(options["degraded_exit_code"]); options["max_concurrency"] = to_int(options["max_concurrency"])
		options["max_providers"] = to_int(options["max_providers"]); options["max_calls"] = to_int(options["max_calls"]); options["max_provider_units"] = to_float(options["max_provider_units"]); options["max_polls"] = to_int(options["max_polls"]); options["max_elapsed_ms"] = to_int(options["max_elapsed_ms"])
		options["max_join_disk_bytes"] = to_int(options["max_join_disk_bytes"])
	} except number_error { return failure("numeric option contains an invalid value") }
	if options["timeout"] <= 0 || options["timeout"] > 120 { return failure("--timeout must be between 0 and 120 seconds") }
	if options["retries"] < 0 || options["retries"] > 5 { return failure("--retries must be between 0 and 5") }
	if options["limit"] < 1 || options["limit"] > 1000 { return failure("--limit must be between 1 and 1000") }
	if options["page_size"] < 1 || options["page_size"] > 25000 || options["max_pages"] < 1 || options["max_pages"] > 1000 || options["max_total_rows"] < 1 || options["max_total_rows"] > 100000 { return failure("pagination budgets are outside supported bounds") }
	if options["max_output_bytes"] < 256 { return failure("--max-output-bytes must be at least 256") }
	if options["max_output_tokens"] < 64 { return failure("--max-output-tokens must be at least 64") }
	if options["cache_max_age"] < 0 || options["task_state_max_age"] < 1 || options["task_state_max_age"] > 604800 || options["max_concurrency"] < 1 || options["max_concurrency"] > 32 { return failure("cache/task-state age or concurrency is outside supported bounds") }
	if options["resume_task"] && options["task_state_dir"] == "" { return failure("--resume-task requires --task-state-dir") }
	if options["max_providers"] < 1 || options["max_providers"] > 8 || options["max_calls"] < 0 || options["max_calls"] > 1000 || options["max_provider_units"] < 0 || options["max_polls"] < 1 || options["max_polls"] > 20 || options["max_elapsed_ms"] < 1 || options["max_elapsed_ms"] > 120000 { return failure("provider execution budgets are outside supported bounds") }
	if !includes(["json", "jsonl"], options["format"]) { return failure("--format must be json or jsonl") }
	if !includes(["info", "warn", "fail"], options["health_policy"]) { return failure("--health-policy must be info, warn, or fail") }
	if !includes(["audit", "migrate", "rotate", "cleanup", "recover"], options["cache_action"]) { return failure("--cache-action must be audit, migrate, rotate, cleanup, or recover") }
	if !includes(["auto", "nested", "spill"], options["join_strategy"]) || options["max_join_disk_bytes"] < 1048576 || options["max_join_disk_bytes"] > 1073741824 { return failure("join strategy or disk budget is outside supported bounds") }
	if options["degraded_exit_code"] < 1 || options["degraded_exit_code"] > 125 { return failure("--degraded-exit-code must be between 1 and 125") }
	return {"ok": true, "value": options}
}

func apply_command_defaults(command, options) {
	if options["dimensions"] == "" {
		if command == "analytics" { options["dimensions"] = "date,pagePath" }
		else { options["dimensions"] = "date,query,page" }
	}
	if options["metrics"] == "" { options["metrics"] = "sessions,screenPageViews" }
	if options["provider"] == "" && command != "fetch" {
		if command == "backlinks" || command == "keyword-data" { options["provider"] = "ahrefs" }
		else if command == "analytics" { options["provider"] = "google-analytics-4" }
		else if command == "pagespeed" { options["provider"] = "pagespeed-insights" }
		else if command == "crux" { options["provider"] = "crux" }
		else if command == "submit" { options["provider"] = "indexnow" }
		else { options["provider"] = "google-search-console" }
	}
	return options
}

func validate_command_options(command, options) {
	if !includes(["doctor", "capabilities", "providers", "version", "evidence-query"], command) && options["offline"] && !options["fixture"] { return failure("offline mode requires --fixture for provider commands") }
	if command == "search-performance" && !includes(["google-search-console", "bing-webmaster"], options["provider"]) { return failure("--provider must be google-search-console or bing-webmaster") }
	if command == "backlinks" && !includes(["ahrefs", "bing-webmaster"], options["provider"]) { return failure("--provider must be ahrefs or bing-webmaster") }
	if command == "submit" && !includes(["indexnow", "bing-webmaster"], options["provider"]) { return failure("--provider must be indexnow or bing-webmaster") }
	if !includes(["mobile", "desktop"], options["strategy"]) { return failure("--strategy must be mobile or desktop") }
	if !includes(["PHONE", "DESKTOP", "TABLET"], options["form_factor"]) { return failure("--form-factor must be PHONE, DESKTOP, or TABLET") }
	if options["replay"] && options["cache_dir"] == "" { return failure("--replay requires --cache-dir") }
	if options["cache_require_encryption"] && options["cache_encryption_key_env"] == "" { return failure("--cache-require-encryption requires --cache-encryption-key-env") }
	if options["filter_field"] != "" && options["filter_equals"] == "" { return failure("--filter-field requires --filter-equals") }
	if options["join_path"] != "" && (options["left_field"] == "" || options["right_field"] == "") { return failure("--join-path requires --left-field and --right-field") }
	if command == "fetch" {
		if options["capability"] == "" || options["provider"] == "" { return failure("fetch requires --capability and --provider") }
		if options["provider"] == "auto" && options["route_preferences"] == "" { return failure("fetch --provider auto requires configured --route-preferences") }
	}
	return {"ok": true, "value": options}
}

func command_capability(command) {
	if command == "search-performance" { return "search.performance" }
	if command == "analytics" { return "analytics" }
	if command == "inspect-url" { return "url.inspection" }
	if command == "pagespeed" { return "page.performance" }
	if command == "crux" { return "field.performance" }
	if command == "backlinks" { return "backlinks" }
	if command == "keyword-data" { return "keyword.data" }
	if command == "submit" { return "index.submission" }
	return ""
}

export func prepare_options(command, tokens) {
	parsed := parse_options(tokens)
	if !parsed["ok"] { return parsed }
	options := apply_command_defaults(command, parsed["value"])
	return validate_command_options(command, options)
}

func invocation_capability(command, options) {
	if includes(["fetch", "adapter-run"], command) { return options["capability"] }
	return command_capability(command)
}

func finalize_result(command, options, result) {
	if !result["ok"] || type(result["value"]) != "dict" { return result }
	value := result["value"]; schema := dict_get(value, "schema", "")
	if !includes(["searchbridge.result/v1", "searchbridge.multi-result/v1", "searchbridge.batch/v1", "searchbridge.evidence-query/v1"], schema) { return result }
	capability := dict_get(value, "capability", invocation_capability(command, options)); mut parents := dict_get(options, "parent_run_ids", [])
	for parent in dict_get(value, "parent_run_ids", []) { if !includes(parents, parent) { parents = push(parents, parent) } }
	replay_run_id := dict_get(dict_get(value, "telemetry", {}), "replay_run_id", ""); if replay_run_id != "" && !includes(parents, replay_run_id) { parents = push(parents, replay_run_id) }
	if schema == "searchbridge.result/v1" && has_key(value, "query") == 0 { value["query"] := {"fingerprint": query_fingerprint(options, capability)} }
	value["provenance"] := provenance_record(options, command, capability, parents)
	return {"ok": true, "value": value}
}

export func dispatch(command, options) {
	capability := invocation_capability(command, options); options["invocation_command"] := command; options["run_id"] := run_identifier(options, command, capability); options["query_fingerprint"] := query_fingerprint(options, capability)
	if command == "adapter-conformance" { return {"ok": true, "value": adapter_conformance_report()} }
	if command == "adapter-run" { options["current_capability"] := options["capability"]; return finalize_result(command, options, run_signed_adapter(options)) }
	if command == "evidence-query" { return finalize_result(command, options, query_evidence(options)) }
	if command == "cache-maintenance" { if options["cache_action"] != "audit" && (!options["act"] || !options["yes"]) { return failure("cache mutations require --act --yes") }; return maintain_cache(options["cache_dir"], options["cache_action"], options["cache_max_age"], options["cache_old_key_env"], options["cache_new_key_env"], current_timestamp(), now_utc()) }
	if command == "batch" { return finalize_result(command, options, command_batch(options)) }
	if command == "fetch" { return finalize_result(command, options, command_fetch(options)) }
	if includes(["doctor", "capabilities", "providers", "agent-catalog", "version"], command) { return static_command(command, options["deterministic"]) }
	options["current_capability"] := command_capability(command)
	if options["current_capability"] != "" { registered := operation_for(options["provider"], options["current_capability"]); if !registered["ok"] { return registered }; adapter := adapters()[options["provider"]]; if !options["fixture"] && adapter["support_tier"] != "stable-live" && !options["allow_unverified_live"] { return failure("direct live execution for support tier " + adapter["support_tier"] + " requires --allow-unverified-live") }; options["adapter_version"] = adapter["adapter_version"]; options = apply_reliability(options, registered["value"]) }
	if command == "search-performance" { return finalize_result(command, options, command_search_performance(options)) }
	if command == "analytics" { return finalize_result(command, options, command_analytics(options)) }
	if command == "inspect-url" { return finalize_result(command, options, command_inspect(options)) }
	if command == "pagespeed" { return finalize_result(command, options, command_pagespeed(options)) }
	if command == "crux" { return finalize_result(command, options, command_crux(options)) }
	if command == "backlinks" { return finalize_result(command, options, command_backlinks(options)) }
	if command == "keyword-data" { return finalize_result(command, options, command_keywords(options)) }
	if command == "submit" { return command_submit(options) }
	return failure("unknown command: " + command)
}

func add_fetch_metadata(value, provider, capability, routing, options) {
	a := adapters()[provider]; op := operation_for(provider, capability); mut operation_id := "compatibility-alias"; if op["ok"] { operation_id = op["value"]["id"] }
	value["contract"] := {"capability": capability + "/v1", "adapter": "searchbridge-adapter/v2"}
	value["source"] := {"provider": provider, "provider_api_version": a["provider_api_version"], "adapter_version": a["adapter_version"], "operation": operation_id, "documentation_checked_at": "2026-09-02"}
	value["query"] := {"fingerprint": query_fingerprint(options, capability)}
	value["budgets"] := {"calls": options["max_calls"], "pages": options["max_pages"], "rows": options["max_total_rows"], "bytes": options["max_output_bytes"], "tokens": options["max_output_tokens"], "provider_units": options["max_provider_units"], "polls": options["max_polls"], "elapsed_ms": options["max_elapsed_ms"]}
	telemetry := value["telemetry"]; actual_units := dict_get(dict_get(telemetry, "provider_cost", {}), "cost", null); cost_class := a["cost_class"]; mut estimated_units := 0; if includes(["metered", "expensive", "unknown"], cost_class) { estimated_units = 1 }
	value["cost"] := {"class": cost_class, "estimated_provider_units": estimated_units, "actual_provider_units": actual_units}
	value["routing"] := routing
	return value
}

func fetch_one(provider, capability, options, routing) {
	options["provider"] = provider; options["current_capability"] = capability
	adapter := adapters()[provider]; if !options["fixture"] && adapter["support_tier"] != "stable-live" && !options["allow_unverified_live"] { return failure("direct live execution for support tier " + adapter["support_tier"] + " requires --allow-unverified-live") }
	registered := operation_for(provider, capability); if registered["ok"] { options = apply_reliability(options, registered["value"]) }
	if includes(["dataforseo", "serpapi", "cloudflare", "semrush"], provider) { return execute_new_provider(provider, capability, options, routing) }
	mut result := null
	if capability == "search.performance" { result = command_search_performance(options) }
	else if capability == "analytics" { result = command_analytics(options) }
	else if capability == "url.inspection" { result = command_inspect(options) }
	else if capability == "page.performance" { result = command_pagespeed(options) }
	else if capability == "field.performance" { result = command_crux(options) }
	else if capability == "backlinks" { result = command_backlinks(options) }
	else if capability == "keyword.data" { result = command_keywords(options) }
	else { return failure("capability has no read executor") }
	if !result["ok"] { return result }; return {"ok": true, "value": add_fetch_metadata(result["value"], provider, capability, routing, options)}
}

func command_fetch(options) {
	capability := options["capability"]; preferences := csv_values(options["route_preferences"]); enabled := csv_values(options["enabled_providers"])
	if options["adapter_manifest"] != "" {
		if includes(["auto", "all"], options["provider"]) { return failure("external adapter fetch requires its explicit provider id") }
		if !options["fixture"] && !options["allow_unverified_live"] { return failure("direct live execution for support tier external-reference requires --allow-unverified-live") }
		requested_provider := options["provider"]; options["current_capability"] = capability; external := run_signed_adapter(options); if !external["ok"] { return external }; if external["value"]["provider"] != requested_provider { return failure("external adapter id does not match --provider") }
		external_value := external["value"]; external_value["routing"] := {"mode": "explicit", "selected": [requested_provider], "candidates": [{"provider": requested_provider, "accepted": true, "reason": "verified signed external adapter"}]}; return {"ok": true, "value": external_value}
	}
	route := resolve(capability, options["provider"], preferences, enabled, !options["fixture"]); if !route["ok"] { return route }; routing := route["value"]; selected := routing["selected"]
	if len(selected) > options["max_providers"] { return failure("resolved providers exceed --max-providers") }
	if options["provider"] != "all" { return fetch_one(selected[0], capability, options, routing) }
	mut results := []; mut succeeded := 0; mut failed := 0; mut total_rows := 0; mut calls_used := 0; mut retries_used := 0; mut pages_used := 0; mut polls_used := 0; mut provider_units_used := 0.0; mut response_bytes_used := 0; mut result_bytes_used := 0; mut processed := 0; started := current_timestamp()
	for provider in selected {
		remaining_providers := len(selected) - processed - 1; processed = processed + 1
		remaining := options["max_total_rows"] - total_rows
		if remaining <= 0 { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_row_budget_exhausted", "retryable": false}}); failed = failed + 1; continue }
		elapsed := current_timestamp() - started; remaining_elapsed := options["max_elapsed_ms"] - elapsed
		if remaining_elapsed <= 0 { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_elapsed_budget_exhausted", "retryable": true}}); failed = failed + 1; continue }
		mut provider_options := options; provider_options["max_total_rows"] = remaining; provider_options["max_elapsed_ms"] = remaining_elapsed; remaining_timeout := to_float(remaining_elapsed) / 1000.0; if provider_options["timeout"] > remaining_timeout { provider_options["timeout"] = remaining_timeout }
		if !options["fixture"] {
			remaining_calls := options["max_calls"] - calls_used; provider_call_budget := remaining_calls - remaining_providers
			if provider_call_budget < 1 { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_call_budget_exhausted", "retryable": false}}); failed = failed + 1; continue }
			provider_options["max_calls"] = provider_call_budget
		}
		remaining_pages := options["max_pages"] - pages_used; provider_page_budget := remaining_pages - remaining_providers
		if provider_page_budget < 1 { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_page_budget_exhausted", "retryable": false}}); failed = failed + 1; continue }; provider_options["max_pages"] = provider_page_budget
		op_result := operation_for(provider, capability); mut async_operation := false; if op_result["ok"] { async_operation = op_result["value"]["pagination"]["strategy"] == "async-task" }
		if async_operation { remaining_polls := options["max_polls"] - polls_used; if remaining_polls < 1 { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_poll_budget_exhausted", "retryable": false}}); failed = failed + 1; continue }; provider_options["max_polls"] = remaining_polls }
		cost_class := adapters()[provider]["cost_class"]; mut estimated_units := 0.0; if includes(["metered", "expensive", "unknown"], cost_class) { estimated_units = 1.0 }
		remaining_units := options["max_provider_units"] - provider_units_used
		if !options["fixture"] && estimated_units > remaining_units { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_provider_unit_budget_exhausted", "retryable": false}}); failed = failed + 1; continue }; provider_options["max_provider_units"] = remaining_units
		result := fetch_one(provider, capability, provider_options, routing)
		if result["ok"] {
			value := result["value"]; telemetry := dict_get(value, "telemetry", {}); pagination := dict_get(value, "pagination", {}); calls := dict_get(telemetry, "attempts", 0); pages := dict_get(pagination, "pages_fetched", 1); polls := dict_get(telemetry, "task_polls", 0); actual_units := dict_get(dict_get(value, "cost", {}), "actual_provider_units", null); mut charged_units := estimated_units; if options["fixture"] { charged_units = 0.0 } else if type(actual_units) != "null" { charged_units = to_float(actual_units) }
			provider_response_bytes := dict_get(telemetry, "response_bytes", 0); value_bytes := utf8_size(to_json(value)); remaining_output_bytes := options["max_output_bytes"] - result_bytes_used
			if response_bytes_used + provider_response_bytes > 8388608 { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_response_budget_exhausted", "retryable": false}}); failed = failed + 1; calls_used = calls_used + calls; pages_used = pages_used + pages; polls_used = polls_used + polls; provider_units_used = provider_units_used + charged_units; response_bytes_used = response_bytes_used + provider_response_bytes; continue }
			if value_bytes > remaining_output_bytes { results = push(results, {"provider": provider, "ok": false, "error": {"code": "global_output_budget_exhausted", "retryable": false}}); failed = failed + 1; calls_used = calls_used + calls; pages_used = pages_used + pages; polls_used = polls_used + polls; provider_units_used = provider_units_used + charged_units; response_bytes_used = response_bytes_used + dict_get(telemetry, "response_bytes", 0); continue }
			total_rows = total_rows + len(value["rows"]); calls_used = calls_used + calls; retries_used = retries_used + dict_get(telemetry, "retries", 0); pages_used = pages_used + pages; polls_used = polls_used + polls; provider_units_used = provider_units_used + charged_units; response_bytes_used = response_bytes_used + provider_response_bytes; result_bytes_used = result_bytes_used + value_bytes
			finalized := finalize_result("fetch", provider_options, {"ok": true, "value": value}); results = push(results, {"provider": provider, "ok": true, "value": finalized["value"]}); succeeded = succeeded + 1
		} else {
			if !options["fixture"] { calls_used = calls_used + provider_options["max_calls"]; provider_units_used = provider_units_used + estimated_units }; pages_used = pages_used + provider_options["max_pages"]; if async_operation { polls_used = polls_used + provider_options["max_polls"] }
			results = push(results, {"provider": provider, "ok": false, "error": {"code": "provider_failed", "retryable": false, "message": clean_error(result["error"])}}); failed = failed + 1
		}
	}
	return {"ok": true, "value": {"schema": "searchbridge.multi-result/v1", "capability": capability, "routing": {"mode": "all", "requested": selected, "candidates": routing["candidates"]}, "budget": {"max_providers": options["max_providers"], "max_calls": options["max_calls"], "calls_used": calls_used, "retries_used": retries_used, "max_pages": options["max_pages"], "pages_used": pages_used, "max_polls": options["max_polls"], "polls_used": polls_used, "max_provider_units": options["max_provider_units"], "provider_units_used": provider_units_used, "max_total_rows": options["max_total_rows"], "rows_used": total_rows, "max_response_bytes": 8388608, "response_bytes_used": response_bytes_used, "max_output_bytes": options["max_output_bytes"], "result_bytes_used": result_bytes_used, "max_elapsed_ms": options["max_elapsed_ms"], "elapsed_ms": current_timestamp() - started}, "succeeded": succeeded, "failed": failed, "results": results}}
}

export func result_exit_code(command, value) {
	if command == "fetch" && type(value) == "dict" && dict_get(value, "schema", "") == "searchbridge.multi-result/v1" && dict_get(value, "succeeded", 0) == 0 { return 1 }
	return 0
}

async func batch_worker(job) {
	if job["options"]["cancel_file"] != "" && file_exists(job["options"]["cancel_file"]) { return {"command": job["command"], "ok": false, "error": "batch cancelled before dispatch"} }
	result := dispatch(job["command"], job["options"])
	if result["ok"] { return {"command": job["command"], "ok": true, "value": result["value"]} }
	return {"command": job["command"], "ok": false, "error": clean_error(result["error"])}
}

func command_batch(options) {
	requested := split(options["commands"], ",")
	if options["commands"] == "" { requested = ["search-performance", "analytics", "pagespeed", "crux", "backlinks", "keyword-data"] }
	mut jobs := []
	for raw in requested {
		name := trim(raw)
		if name == "" { continue }
		if !includes(["search-performance", "analytics", "inspect-url", "pagespeed", "crux", "backlinks", "keyword-data"], name) { return failure("batch only accepts independent read commands") }
		mut item_options := {}; for key in keys(options) { item_options[key] := options[key] }; item_options["provider"] = ""; item_options["parent_run_ids"] = [options["run_id"]]; item_options["run_id"] = ""
		item_options = apply_command_defaults(name, item_options); jobs = push(jobs, {"command": name, "options": item_options})
	}
	results := await parallel_map(jobs, batch_worker, options["max_concurrency"]); mut succeeded := 0; mut failed := 0
	for result in results { if result["ok"] { succeeded = succeeded + 1 } else { failed = failed + 1 } }
	return {"ok": true, "value": {"schema": "searchbridge.batch/v1", "bounded_concurrency": options["max_concurrency"], "execution": "bounded-worker-pool", "cancel_file": options["cancel_file"], "succeeded": succeeded, "failed": failed, "results": results}}
}

async func timing_worker(job) { await async_sleep(job["delay"]); return job["id"] }
export func batch_worker_pool_probe() {
	jobs := [{"id": 0, "delay": 80}, {"id": 1, "delay": 80}, {"id": 2, "delay": 80}]
	started := current_timestamp(); ordered := await parallel_map(jobs, timing_worker, 3); elapsed_ms := current_timestamp() - started
	return {"ordered": ordered, "elapsed_ms": elapsed_ms, "serial_ms": 240, "overlapped": elapsed_ms < 200}
}

export func render_output(value, options) {
	if type(value) == "dict" && has_key(value, "_already_streamed") && value["_already_streamed"] { return {"ok": true, "value": "", "streamed": true} }
	if options["format"] == "jsonl" && type(value) == "dict" && has_key(value, "rows") {
		provenance := dict_get(value, "provenance", {})
		mut total := 0
		for row in value["rows"] {
			line := to_json({"schema": "searchbridge.row/v1", "capability": value["capability"], "provider": value["provider"], "provenance": provenance, "row": row}) + "\n"
			total = total + utf8_size(line); if total > options["max_output_bytes"] || total > options["max_output_tokens"] * 4 { return failure("output budget exceeded (" + to_string(total) + " bytes)") }
		}
		mut output_path := options["out"]; if output_path != "" { output_path = options["out"] + ".searchbridge-tmp-" + to_string(current_timestamp()); write_file(output_path, "", true) }
		for row in value["rows"] {
			line := to_json({"schema": "searchbridge.row/v1", "capability": value["capability"], "provider": value["provider"], "provenance": provenance, "row": row}) + "\n"
			if options["out"] != "" { append_file(output_path, line) } else { print(trim_end(line)) }
		}
		if options["out"] != "" { try { if file_exists(options["out"]) { delete_file(options["out"]) }; rename_file(output_path, options["out"]) } except publish_error { if file_exists(output_path) { delete_file(output_path) }; return failure("could not publish output atomically") } }
		return {"ok": true, "value": "", "streamed": true}
	}
	text := to_json(value) + "\n"
	size := utf8_size(text)
	if size > options["max_output_bytes"] || size > options["max_output_tokens"] * 4 { return failure("output budget exceeded (" + to_string(size) + " bytes)") }
	if options["out"] != "" {
		try { write_file(options["out"], text, true) }
		except write_error { return failure("could not write output: " + to_string(write_error)) }
	}
	return {"ok": true, "value": text}
}

func print_help() {
	print("SearchBridge " + VERSION + " — Kujo-native provider evidence gateway")
	print("")
	print("Usage: ./searchbridge <command> [options]")
	print("")
	print("Commands: doctor, capabilities, providers, agent-catalog, version, search-performance,")
	print("          fetch, analytics, inspect-url, pagespeed, crux, backlinks, keyword-data, batch, submit,")
	print("          adapter-conformance, adapter-run, evidence-query, cache-maintenance")
	print("")
	print("Common options: --fixture --offline --deterministic --out PATH")
	print("                --timeout SEC --retries N --limit N --format json|jsonl")
	print("                --page-size N --max-pages N --max-total-rows N")
	print("                --config PATH --profile NAME --cache-dir PATH --replay")
	print("                --task-state-dir PATH [--resume-task] --task-state-max-age SEC")
	print("Evidence join: --join-strategy auto|nested|spill --join-temp-dir PATH --max-join-disk-bytes N")
	print("                --otel-endpoint HTTPS_OR_FILE --cancel-file PATH")
	print("                --max-output-bytes N --max-output-tokens N")
	print("Fetch: --capability ID --provider ID|auto|all [--route-preferences IDS] [--allow-unverified-live]")
	print("Run README examples for provider-specific options.")
}

export func run_cli(argv) {
	if len(argv) == 0 || argv[0] == "help" || argv[0] == "--help" || argv[0] == "-h" { print_help(); return 0 }
	mut command := argv[0]
	if command == "--version" || command == "-V" { command = "version" }
	if !includes(commands(), command) { eprint("SearchBridge: unknown command: " + command); return 2 }
	if len(argv) > 1 && (argv[1] == "--help" || argv[1] == "-h") { print_help(); return 0 }
	validated := prepare_options(command, slice(argv, 1, len(argv)))
	if !validated["ok"] { eprint("SearchBridge: " + validated["error"]); return 2 }
	options := validated["value"]
	result := dispatch(command, options)
	if !result["ok"] { eprint("SearchBridge: " + clean_error(result["error"])); return 1 }
	otel := export_otel(command, result["value"], options, options["transport"]); if !otel["ok"] { eprint("SearchBridge: " + otel["error"]); return 1 }
	rendered := render_output(result["value"], options)
	if !rendered["ok"] { eprint("SearchBridge: " + rendered["error"]); return 1 }
	if has_key(rendered, "streamed") == 0 { print(trim_end(rendered["value"])) }
	if includes(["doctor", "capabilities"], command) && options["health_policy"] == "fail" {
		required := split(options["require_capabilities"], ","); unavailable := []
		if has_key(result["value"], "unavailable_capabilities") { unavailable = result["value"]["unavailable_capabilities"] }
		if command == "capabilities" { for item in result["value"]["capabilities"] { if item["degraded"] { unavailable = push(unavailable, item["capability"]) } } }
		for capability in required { if capability != "" && includes(unavailable, capability) { return options["degraded_exit_code"] } }
		if options["require_capabilities"] == "" && len(unavailable) > 0 { return options["degraded_exit_code"] }
	}
	return result_exit_code(command, result["value"])
}
