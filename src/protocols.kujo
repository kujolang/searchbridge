from src.core import failure, success, clean_error, utf8_size, dict_get, includes

export func validate_exact_endpoint(url, template, allow_query) {
	if !starts_with(url, "https://") || contains(url, "@") || contains(url, "#") || !regex_match(url, "^[ -~]+$") { return failure("provider endpoint must be safe ASCII HTTPS without user-info or fragments") }
	lowered := to_lower(url)
	for denied in ["https://localhost", "https://127.", "https://10.", "https://192.168.", "https://169.254.", "https://172.16.", "https://172.17.", "https://172.18.", "https://172.19.", "https://172.20.", "https://172.21.", "https://172.22.", "https://172.23.", "https://172.24.", "https://172.25.", "https://172.26.", "https://172.27.", "https://172.28.", "https://172.29.", "https://172.30.", "https://172.31.", "https://[::1]", "https://[fc", "https://[fd", "https://[fe80", "https://0.0.0.0"] { if starts_with(lowered, denied) { return failure("provider endpoint resolves to a denied destination") } }
	if url == template { return success(url) }
	if allow_query && starts_with(url, template + "?") { return success(url) }
	return failure("provider endpoint does not match its exact approved template")
}

export func validate_template_endpoint(url, template, slot, value) {
	if !regex_match(slot, "^\\{[a-z_]+\\}$") || !regex_match(value, "^[A-Za-z0-9._:-]{1,256}$") || contains(template, slot) == 0 { return failure("invalid endpoint template slot") }
	expected := replace(template, slot, value); if url != expected { return failure("expanded endpoint does not match its approved template") }
	return validate_exact_endpoint(url, expected, false)
}

export func cost_preflight(cost_class, fixture_mode, allow_paid, max_calls, max_units) {
	if fixture_mode { return success({"estimated_calls": 0, "estimated_provider_units": 0}) }
	if includes(["metered", "expensive", "unknown"], cost_class) && (!allow_paid || max_calls < 1 || max_units < 1) { return failure("paid or unknown live provider requires --allow-paid, --max-calls, and sufficient --max-provider-units") }
	if max_calls < 1 { return failure("live provider requires a positive --max-calls budget") }
	return success({"estimated_calls": 1, "estimated_provider_units": 1})
}

export func cursor_sequence(cursors, max_pages) {
	mut seen := []; mut accepted := []
	for cursor in cursors {
		if len(accepted) >= max_pages { return failure("cursor page budget exceeded") }
		if type(cursor) != "string" || len(cursor) > 1024 || regex_match(cursor, "[\\r\\n\\t]") { return failure("invalid provider cursor") }
		if includes(seen, cursor) { return failure("provider repeated a pagination cursor") }
		seen = push(seen, cursor); accepted = push(accepted, cursor)
	}
	return success(accepted)
}

export func async_task_sequence(states, max_polls, max_elapsed_ms) {
	mut polls := 0; mut elapsed := 0
	for state in states {
		if polls >= max_polls || elapsed > max_elapsed_ms { return failure("provider task polling budget exceeded") }
		id := dict_get(state, "id", ""); if id == "" || len(id) > 256 || regex_match(id, "[\\r\\n\\t]") { return failure("invalid provider task id") }
		status := dict_get(state, "status", ""); elapsed = elapsed + dict_get(state, "elapsed_ms", 0); polls = polls + 1
		if status == "completed" { return success({"polls": polls, "elapsed_ms": elapsed, "result": dict_get(state, "result", {})}) }
		if status == "failed" { return failure("provider task failed") }
		if status != "pending" { return failure("unknown provider task status") }
	}
	return failure("provider task did not complete within supplied sequence")
}

export func bounded_csv_parse(text, max_rows, max_columns, max_cell_bytes) {
	if utf8_size(text) > 8388608 { return failure("CSV response exceeded 8 MiB") }
	first_line := split(text, "\n")[0]; mut delimiter := ","; if contains(first_line, ";") > contains(first_line, ",") { delimiter = ";" }
	mut normalized := text; mut header_columns := len(split(first_line, delimiter)); unquoted := contains(text, "\"") == 0
	if unquoted && regex_match(text, "[^,;\\r\\n]{" + to_string(max_cell_bytes + 1) + ",}") { return failure("CSV cell budget exceeded") }
	if delimiter == ";" && unquoted { normalized = replace(text, ";", ",") }
	else if delimiter == ";" {
		normalized = ""; mut quoted := false; mut i := 0; header_columns = 1; mut in_header := true
		while i < count_chars(text) {
			character := char_at(text, i)
			if character == "\"" {
				if quoted && i + 1 < count_chars(text) && char_at(text, i + 1) == "\"" { normalized = normalized + "\"\""; i = i + 2; continue }
				quoted = !quoted; normalized = normalized + character
			} else if character == ";" && !quoted { normalized = normalized + ","; if in_header { header_columns = header_columns + 1 } }
			else { normalized = normalized + character; if character == "\n" && !quoted { in_header = false } }
			i = i + 1
		}
	}
	if header_columns > max_columns { return failure("CSV column budget exceeded") }
	try {
		rows := parse_csv(normalized); if len(rows) > max_rows { return failure("CSV row budget exceeded") }
		if len(rows) > 0 && len(keys(rows[0])) != header_columns { return failure("CSV contains duplicate or empty headers") }
		if !unquoted { for row in rows { for key in keys(row) { cell := to_string(row[key]); if len(cell) > max_cell_bytes / 4 && utf8_size(cell) > max_cell_bytes { return failure("CSV cell budget exceeded") } } } }
		return success(rows)
	} except csv_error { return failure("provider returned invalid CSV: " + clean_error(csv_error)) }
}

export func graphql_result(payload) {
	if type(payload) != "dict" { return failure("provider returned invalid GraphQL JSON") }
	if len(dict_get(payload, "errors", [])) > 0 { return failure("provider GraphQL operation failed") }
	if type(dict_get(payload, "data", null)) != "dict" { return failure("provider GraphQL response omitted data") }
	return success(payload["data"])
}

export func stream_synthetic_jsonl(output_path, total_rows, max_bytes) {
	if total_rows < 0 || total_rows > 100000 { return failure("synthetic streaming row budget exceeded") }
	temporary := output_path + ".searchbridge-tmp-" + to_string(current_timestamp()); write_file(temporary, "", true); line := "{\"row\":{\"id\":0},\"schema\":\"searchbridge.row/v1\"}\n"; line_bytes := utf8_size(line); bytes := line_bytes * total_rows
	if bytes > max_bytes { delete_file(temporary); return failure("synthetic streaming byte budget exceeded") }
	page_size := 1000; full_page := repeat(line, page_size); mut written := 0
	while written + page_size <= total_rows { append_file(temporary, full_page); written = written + page_size }
	if written < total_rows { append_file(temporary, repeat(line, total_rows - written)) }
	try { if file_exists(output_path) { delete_file(output_path) }; rename_file(temporary, output_path) }
	except publish_error { if file_exists(temporary) { delete_file(temporary) }; return failure("could not publish synthetic stream") }
	return success({"rows": total_rows, "bytes": bytes, "retained_rows": page_size, "atomic": true})
}
