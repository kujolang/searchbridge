from src.core import MAX_PROVIDER_BYTES, clean_error, failure, success, dict_get, utf8_size, includes, value_within_bounds
from src.cache import credential_independent_request_hash, read_protected_cached_response, write_protected_cached_response
from src.protocols import bounded_csv_parse

export func should_retry_status(status) {
	return status == 429 || status == 500 || status == 502 || status == 503 || status == 504
}

func policy_retries_status(status, policy) { return includes(dict_get(policy, "retry_statuses", [429, 500, 502, 503, 504]), status) }

func default_transport(url, options) { return http_request(url, options) }

func header_value(headers, wanted) {
	if type(headers) != "dict" { return "" }
	for key in keys(headers) { if to_lower(key) == to_lower(wanted) { return to_string(headers[key]) } }
	return ""
}

func retry_delay(response, attempt, policy) {
	mut delay_ms := 250
	mut step := 1
	while step < attempt { delay_ms = delay_ms * 2; step = step + 1 }
	headers := dict_get(response, "_headers", dict_get(response, "headers", {}))
	retry_after := header_value(headers, "retry-after")
	if regex_match(retry_after, "^[0-9]+$") { delay_ms = to_int(retry_after) * 1000 }
	cap := dict_get(policy, "retry_delay_cap_ms", 5000)
	if delay_ms > cap { delay_ms = cap }
	jitter_cap := dict_get(policy, "retry_jitter_ms", 100)
	if jitter_cap > 0 && !dict_get(policy, "deterministic", false) { delay_ms = delay_ms + random_int(0, jitter_cap) }
	return delay_ms
}

func safe_cost(headers) {
	mut cost := {}
	for name in ["x-api-units-cost", "x-api-units-limit", "x-api-units-remaining"] {
		value := header_value(headers, name); if value != "" && regex_match(value, "^[0-9.]+$") { cost[replace(name, "x-api-units-", "")] := value }
	}
	return cost
}

export func request_json(url, method, body, headers, policy, transport) {
	if dict_get(policy, "offline", false) && !dict_get(policy, "replay", false) { return failure("offline mode blocks live provider requests") }
	bound_request := {"body": body, "provider": dict_get(policy, "provider", ""), "adapter_version": dict_get(policy, "adapter_version", ""), "capability": dict_get(policy, "current_capability", ""), "profile": dict_get(policy, "profile", "")}
	request_hash := credential_independent_request_hash(method, url, bound_request)
	cache_dir := dict_get(policy, "cache_dir", "")
	capability := dict_get(policy, "current_capability", "")
	mut allowed_replays := dict_get(policy, "replay_capabilities", [])
	if type(allowed_replays) == "string" { allowed_replays = split(allowed_replays, ",") }
	if cache_dir != "" && len(allowed_replays) > 0 && !includes(allowed_replays, capability) { return failure("cache/replay capability is not allowlisted") }
	backend := {"encryption_key_env": dict_get(policy, "cache_encryption_key_env", ""), "require_encryption": dict_get(policy, "cache_require_encryption", false), "provenance": {"run_id": dict_get(policy, "run_id", ""), "query_fingerprint": dict_get(policy, "query_fingerprint", "")}}
	if cache_dir != "" {
		cached := read_protected_cached_response(cache_dir, request_hash, dict_get(policy, "cache_max_age", 86400), current_timestamp(), backend)
		if cached["ok"] {
			value := cached["value"]
			replay_run_id := dict_get(dict_get(value, "provenance", {}), "run_id", ""); return success({"status": value["status"], "body": value["body"], "telemetry": {"attempts": 0, "retries": 0, "latency_ms": 0, "retry_delay_ms": 0, "response_bytes": utf8_size(to_json(value["body"])), "cache_status": "hit", "provider_cost": {}, "replay_run_id": replay_run_id}})
		}
		if dict_get(policy, "replay", false) { return failure("approved replay unavailable: " + cached["error"]) }
	}
	mut merged := {"User-Agent": dict_get(policy, "user_agent", "Kujo-SearchBridge"), "Accept": "application/json"}
	for key in keys(headers) { merged[key] := headers[key] }
	if type(body) != "null" { merged["Content-Type"] := "application/json" }
	mut request_options := {"method": method, "headers": merged, "timeout": dict_get(policy, "timeout", 30), "redirects": "none", "destination_policy": "deny_private", "pin_dns": true, "max_response_bytes": MAX_PROVIDER_BYTES}
	if type(body) != "null" { request_options["body"] = to_json(body) }
	mut call_transport := transport; if type(call_transport) == "null" { call_transport = default_transport }
	mut attempt := 0
	mut max_attempts := dict_get(policy, "retries", 2) + 1
	call_budget := dict_get(policy, "max_calls", 0)
	if call_budget > 0 && max_attempts > call_budget { max_attempts = call_budget }
	mut last_error := "provider request failed"
	mut total_delay := 0
	mut consecutive_failures := 0; circuit_threshold := dict_get(policy, "circuit_failure_threshold", max_attempts); if circuit_threshold < 1 { circuit_threshold = 1 }
	started := current_timestamp()
	while attempt < max_attempts {
		cancel_file := dict_get(policy, "cancel_file", ""); if cancel_file != "" && file_exists(cancel_file) { return failure("provider request cancelled") }
		request_options["_attempt"] = attempt
		request_result := call_transport(url, request_options)
		mut retry_response := {}
		match request_result {
			case Ok(response): {
				retry_response = response
				status := dict_get(response, "_status", dict_get(response, "status", 0)); raw := dict_get(response, "_body", dict_get(response, "body", ""))
				if utf8_size(raw) > MAX_PROVIDER_BYTES { return failure("provider response exceeded 8 MiB") }
				if status >= 200 && status < 300 {
					mut payload := raw; if payload == "" { payload = "{}" }
					try {
						mut parsed := null; response_format := dict_get(policy, "response_format", "json")
						if response_format == "csv" { csv_result := bounded_csv_parse(payload, dict_get(policy, "max_total_rows", 1000), dict_get(policy, "max_csv_columns", 256), dict_get(policy, "max_csv_cell_bytes", 65536)); if !csv_result["ok"] { return csv_result }; parsed = csv_result["value"] }
						else if includes(["json", "graphql-json"], response_format) { parsed = parse_json(payload) }
						else { return failure("unsupported provider response format") }
						if !value_within_bounds(parsed, 0) { return failure("provider response structure exceeded safety bounds") }; response_headers := dict_get(response, "_headers", dict_get(response, "headers", {}))
						mut cache_status := "disabled"; if cache_dir != "" { written := write_protected_cached_response(cache_dir, request_hash, status, parsed, current_timestamp(), now_utc(), backend); if !written["ok"] { return written }; cache_status = "miss-written" }
						return success({"status": status, "body": parsed, "telemetry": {"attempts": attempt + 1, "retries": attempt, "latency_ms": current_timestamp() - started, "retry_delay_ms": total_delay, "response_bytes": utf8_size(payload), "cache_status": cache_status, "provider_cost": safe_cost(response_headers), "circuit_state": "closed"}})
					} except parse_error { return failure("provider returned invalid JSON") }
				}
				last_error = "provider returned HTTP " + to_string(status); if !policy_retries_status(status, policy) { return failure(last_error) }
			}
			case Err(transport_error): { last_error = clean_error(transport_error) }
			case other: { last_error = "unexpected transport result: " + type(other) }
		}
		consecutive_failures = consecutive_failures + 1; if consecutive_failures >= circuit_threshold { return failure("provider circuit opened after " + to_string(consecutive_failures) + " consecutive failures") }
		attempt = attempt + 1
		if attempt < max_attempts { delay_ms := retry_delay(retry_response, attempt, policy); total_delay = total_delay + delay_ms; sleep(delay_ms) }
	}
	return failure(last_error)
}

export func retry_contract_probe() {
	retry_transport := func(_url, _options) {
		if _options["_attempt"] == 0 { return Ok({"_status": 429, "_body": "{}", "_headers": {"Retry-After": "0"}}) }
		return Ok({"_status": 202, "_body": "{}"})
	}
	retried := request_json("https://example.invalid", "POST", {}, {}, {"offline": false, "timeout": 1, "retries": 2, "user_agent": "test", "deterministic": true}, retry_transport)
	capped_transport := func(_url, _options) { return Err("token=super-secret timeout") }
	failed := request_json("https://example.invalid", "GET", null, {}, {"offline": false, "timeout": 1, "retries": 1, "user_agent": "test", "deterministic": true}, capped_transport)
	return {"retried": retried, "failed": failed}
}

export func call_budget_contract_probe() {
	budget_transport := func(_url, request_options) { if request_options["_attempt"] == 0 { return Ok({"_status": 503, "_body": "{}"}) }; return Ok({"_status": 200, "_body": "{}"}) }
	limited := request_json("https://example.invalid", "GET", null, {}, {"offline": false, "timeout": 1, "retries": 5, "max_calls": 1, "deterministic": true}, budget_transport)
	sufficient := request_json("https://example.invalid", "GET", null, {}, {"offline": false, "timeout": 1, "retries": 5, "max_calls": 2, "deterministic": true}, budget_transport)
	return {"limited": limited, "sufficient": sufficient}
}

export func circuit_contract_probe() {
	non_retry_transport := func(_url, _options) { return Ok({"_status": 500, "_body": "{}"}) }; excluded := request_json("https://example.invalid", "GET", null, {}, {"offline": false, "timeout": 1, "retries": 3, "retry_statuses": [429], "circuit_failure_threshold": 4, "deterministic": true}, non_retry_transport)
	failing_transport := func(_url, _options) { return Err("token=never-log-this") }; opened := request_json("https://example.invalid", "GET", null, {}, {"offline": false, "timeout": 1, "retries": 5, "retry_statuses": [429, 500, 502, 503, 504], "retry_delay_cap_ms": 0, "retry_jitter_ms": 0, "circuit_failure_threshold": 2, "deterministic": true}, failing_transport)
	return {"excluded": excluded, "opened": opened}
}

export func gsc_page_contract_transport(_url, request_options) {
	body := parse_json(request_options["body"]); offset := body["startRow"]
	mut rows := [{"keys": ["2026-08-01", "a"], "clicks": 1}]
	if offset == 0 { rows = push(rows, {"keys": ["2026-08-01", "b"], "clicks": 2}) }
	return Ok({"_status": 200, "_body": to_json({"rows": rows})})
}

export func ga_page_contract_transport(_url, request_options) {
	body := parse_json(request_options["body"]); offset := to_int(body["offset"])
	mut rows := [{"dimensionValues": [{"value": "2026-08-01"}], "metricValues": [{"value": "1"}]}]
	if offset == 0 { rows = push(rows, {"dimensionValues": [{"value": "2026-08-02"}], "metricValues": [{"value": "2"}]}) }
	return Ok({"_status": 200, "_body": to_json({"dimensionHeaders": [{"name": "date"}], "metricHeaders": [{"name": "sessions"}], "rows": rows})})
}

export func dataforseo_task_contract_transport(url, _request_options) {
	if ends_with(url, "/task_post") { return Ok({"_status": 200, "_body": to_json({"tasks": [{"id": "synthetic-task"}]})}) }
	return Ok({"_status": 200, "_body": to_json({"tasks": [{"id": "synthetic-task", "result": [{"keyword": "kujo language", "items": [{"type": "organic", "rank_absolute": 4, "rank_group": 1, "url": "https://example.com/kujo"}]}]}]})})
}

export func plausible_page_contract_transport(_url, request_options) {
	body := parse_json(request_options["body"]); if dict_get(body, "site_id", "") != "example.com" || dict_get(body, "metrics", []) != ["visitors", "visits"] || dict_get(body, "dimensions", []) != ["date", "page"] || dict_get(body, "date_range", []) != ["2026-09-01", "2026-09-02"] { return Ok({"_status": 400, "_body": "{}"}) }
	offset := dict_get(dict_get(body, "pagination", {}), "offset", 0); mut results := [{"date": "2026-09-01", "page": "/", "visitors": "12", "visits": "15"}, {"date": "2026-09-02", "page": "/docs", "visitors": "8", "visits": "9"}]; if offset > 0 { results = [{"date": "2026-09-03", "page": "/about", "visitors": "4", "visits": "5"}] }
	return Ok({"_status": 200, "_body": to_json({"results": results})})
}

export func csv_contract_transport(_url, _request_options) { return Ok({"_status": 200, "_body": "name;value\nalpha;1\nbeta;2\n"}) }

export func external_pagination_contract_transport(url, request_options) {
	mut body := {}; if dict_get(request_options, "body", "") != "" { body = parse_json(request_options["body"]) }; pagination := dict_get(body, "pagination", {})
	if contains(url, "/cursor") { cursor := dict_get(pagination, "cursor", ""); if cursor == "" { return Ok({"_status": 200, "_body": to_json({"rows": [{"id": "cursor-1"}], "next": "next-1"})}) }; return Ok({"_status": 200, "_body": to_json({"rows": [{"id": "cursor-2"}], "next": ""})}) }
	if contains(url, "/page") { page := dict_get(pagination, "page", 1); if page == 1 { return Ok({"_status": 200, "_body": to_json({"rows": [{"id": "page-1"}, {"id": "page-2"}]})}) }; return Ok({"_status": 200, "_body": to_json({"rows": [{"id": "page-3"}]})}) }
	if contains(url, "/async/start") { return Ok({"_status": 202, "_body": to_json({"task": {"id": "task-1", "status": "pending"}})}) }
	if contains(url, "/async/result/task-1") { return Ok({"_status": 200, "_body": to_json({"task": {"id": "task-1", "status": "completed", "result": {"rows": [{"id": "async-1"}]}}})}) }
	if contains(url, "/query?") { return Ok({"_status": 200, "_body": to_json({"rows": [{"id": url}]})}) }
	if contains(url, "/format/csv") { return Ok({"_status": 200, "_body": "id,value\ncsv-1,42\n"}) }
	if contains(url, "/format/graphql") { return Ok({"_status": 200, "_body": to_json({"data": {"rows": [{"id": "graphql-1"}]}})}) }
	return Ok({"_status": 404, "_body": "{}"})
}
